---
// BSTVisualizer.astro
// Step-through player for LeetCode 230: kth smallest via iterative inorder.
// No dependencies, vanilla JS, dark-mode aware, keyboard accessible.
interface Props {
  id?: string;
}
const { id = "bst-main" } = Astro.props;
---

<div class="bsviz" data-bsviz={id}>
  <div class="bsviz-card">
    <div class="bsviz-head">
      <div>
        <p class="bsviz-kicker">Interactive visual · Inorder Walk</p>
        <h3 class="bsviz-title">Can you stop at the kth smallest?</h3>
        <p class="bsviz-sub">
          Inorder on a BST visits nodes in <strong>sorted order</strong>: left → node → right.
          Count each pop: <em>1st, 2nd, 3rd…</em> — when count hits <em>k</em>, you are done.
          Pick a <em>k</em> and press <strong>Play</strong>.
        </p>
      </div>
      <div class="bsviz-presets" role="group" aria-label="Choose k">
        <button type="button" data-k="1">k=1</button>
        <button type="button" data-k="2">k=2</button>
        <button type="button" data-k="3" class="is-active">k=3</button>
        <button type="button" data-k="4">k=4</button>
        <button type="button" data-k="5">k=5</button>
        <button type="button" data-k="6">k=6</button>
      </div>
    </div>

    <div class="bsviz-stage">
      <p class="bsviz-row-label"><span>tree root=[5,3,6,2,4,null,null,1]</span><span>k = <strong data-role="k-label">3</strong></span></p>
      <svg class="bsviz-tree" viewBox="0 0 420 250" role="img" aria-label="BST with values 5,3,6,2,4,1">
        <g class="bsviz-edges" stroke-width="1.5">
          <line x1="210" y1="36" x2="120" y2="96" />
          <line x1="210" y1="36" x2="300" y2="96" />
          <line x1="120" y1="96" x2="70" y2="156" />
          <line x1="120" y1="96" x2="170" y2="156" />
          <line x1="70" y1="156" x2="45" y2="216" />
        </g>
        <g data-node="5" transform="translate(210,30)"><circle r="16" /><text y="5">5</text></g>
        <g data-node="3" transform="translate(120,96)"><circle r="16" /><text y="5">3</text></g>
        <g data-node="6" transform="translate(300,96)"><circle r="16" /><text y="5">6</text></g>
        <g data-node="2" transform="translate(70,156)"><circle r="16" /><text y="5">2</text></g>
        <g data-node="4" transform="translate(170,156)"><circle r="16" /><text y="5">4</text></g>
        <g data-node="1" transform="translate(45,216)"><circle r="16" /><text y="5">1</text></g>
      </svg>

      <p class="bsviz-row-label"><span>visit order (inorder)</span><span data-role="found-label"></span></p>
      <div class="bsviz-order" data-role="order" aria-live="polite"></div>

      <p class="bsviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="bsviz-controls">
      <div class="bsviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="bsviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 1</span>
          <input type="range" data-role="slider" min="0" max="0" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="bsviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="bsviz-codegrid">
      <div class="bsviz-code" aria-label="Algorithm code with current line highlighted">
        <div data-code="0"><span class="ln">1</span><code>stack=[]; curr=root; count=0</code></div>
        <div data-code="1"><span class="ln">2</span><code>go left as far as possible</code></div>
        <div data-code="2"><span class="ln">3</span><code>curr=pop; count+=1</code></div>
        <div data-code="3"><span class="ln">4</span><code>if count==k: return curr.val; else visit right</code></div>
      </div>
      <div class="bsviz-quiz">
        <p class="bsviz-quiz-title">Quick check — make it stick</p>
        <p class="bsviz-quiz-q">Why does inorder give sorted order on a BST?</p>
        <div class="bsviz-quiz-btns">
          <button type="button" data-quiz="a">It visits bigger nodes first</button>
          <button type="button" data-quiz="b">Left subtree &lt; node &lt; right, so left→node→right is sorted</button>
          <button type="button" data-quiz="c">Stacks sort things</button>
        </div>
        <p class="bsviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        <p class="bsviz-mnemonic">🧠 Memory hook: <strong>“BST + kth smallest → think inorder.”</strong> Sorted order falls out of left→node→right.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .bsviz { margin: 1.75rem 0; }
  .bsviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .bsviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .bsviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .bsviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .bsviz-sub strong, .bsviz-sub em { color: var(--ink); }
  .bsviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  @media (min-width: 720px) { .bsviz-head { grid-template-columns: 1fr auto; align-items: start; } }
  .bsviz-presets { display: flex; flex-wrap: wrap; gap: .4rem; align-content: start; }
  .bsviz-presets button {
    font-family: var(--font-mono); font-size: .75rem;
    border: 1px solid var(--line); border-radius: 999px;
    padding: .35rem .7rem; color: var(--muted); background: transparent; cursor: pointer;
  }
  .bsviz-presets button.is-active, .bsviz-presets button:hover {
    color: var(--accent-strong); border-color: var(--accent);
  }
  .bsviz-row-label {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: .75rem; color: var(--muted);
    margin: .2rem 0 .5rem;
  }
  .bsviz-row-label strong { color: var(--accent-strong); font-size: .95rem; }
  .bsviz-tree { width: 100%; height: auto; display: block; }
  .bsviz-edges line { stroke: var(--line); }
  .bsviz-tree [data-node] circle {
    fill: var(--surface); stroke: var(--line); stroke-width: 1.5;
    transition: fill .2s, stroke .2s;
  }
  .bsviz-tree [data-node] text {
    text-anchor: middle; font-weight: 800; font-size: 14px; fill: var(--ink);
  }
  .bsviz-tree [data-node].is-current circle { stroke: var(--accent); stroke-width: 2.5; }
  .bsviz-tree [data-node].is-visited circle {
    stroke: var(--accent);
    fill: color-mix(in oklab, var(--accent) 14%, var(--surface));
  }
  .bsviz-tree [data-node].is-found circle { stroke: #22c55e; stroke-width: 2.5; fill: color-mix(in oklab, #22c55e 18%, var(--surface)); }
  .bsviz-tree [data-node].is-skipped { opacity: .45; }
  .bsviz-order { display: flex; flex-wrap: wrap; gap: .4rem; }
  .bsviz-chip {
    font-family: var(--font-mono); font-size: .75rem;
    border: 1px solid var(--line); border-radius: .55rem; padding: .3rem .5rem;
    background: var(--surface); color: var(--muted);
  }
  .bsviz-chip.is-visited { border-color: var(--accent); color: var(--accent-strong); }
  .bsviz-chip.is-found { border-color: #22c55e; color: #16a34a; font-weight: 700; }
  .bsviz-chip.is-skipped { opacity: .5; }
  .bsviz-caption {
    margin: .9rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
  }
  .bsviz-caption.is-found { border-left-color: #22c55e; }
  .bsviz-controls { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .bsviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .bsviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .bsviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .bsviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .bsviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .bsviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .bsviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .bsviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .bsviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .bsviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .bsviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .bsviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .bsviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .bsviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .bsviz-code code { white-space: pre-wrap; }
  .bsviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .bsviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .bsviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .bsviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .bsviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .bsviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .bsviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .bsviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .bsviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .bsviz-mnemonic strong { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .bsviz-tree [data-node] circle { transition: none; }
  }
</style>

<script>
  function initBSTViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";

    const visitOrder = [1, 2, 3, 4, 5, 6];
    const ordinals = ["1st", "2nd", "3rd", "4th", "5th", "6th"];
    // Stack contents right after each pop (incl. push of right subtree).
    const stacksAfter = [
      "[5, 3, 2]",
      "[5, 3]",
      "[5, 4]",
      "[5]",
      "[6]",
      "[]",
    ];
    const rightNote = [
      "right of 1 is empty → up to 2",
      "right of 2 is empty → up to 3",
      "visit right: push 4",
      "right of 4 is empty → up to 5",
      "visit right: push 6",
      "right of 6 is empty → done",
    ];

    let k = 3;
    let steps = [];
    let idx = 0;
    let timer = null;

    const elKLabel = root.querySelector('[data-role="k-label"]');
    const elFoundLabel = root.querySelector('[data-role="found-label"]');
    const elOrder = root.querySelector('[data-role="order"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll("[data-code]")];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');
    const nodeEls = {};
    root.querySelectorAll("[data-node]").forEach((g) => { nodeEls[g.dataset.node] = g; });

    function buildSteps(kk) {
      const target = visitOrder[kk - 1];
      const out = [];
      out.push({
        visitIdx: -1, value: null, count: 0, code: 0,
        caption: `Start — Current: 5 (root) · Stack: [] · Count: 0 · Decision: push the left spine 5→3→2→1, then pop.`,
      });
      visitOrder.forEach((val, i) => {
        const count = i + 1;
        const isTarget = count === kk;
        const pastTarget = count > kk;
        // First visit highlights the initial left descent; the rest highlight pop+count.
        const code = i === 0 ? 1 : 2;
        let caption;
        if (pastTarget) {
          caption = `Skipped — Current: ${val} · Stack: ${stacksAfter[i]} · Count: ${kk} (stopped) · Decision: already returned ${target}; this visit never happens.`;
        } else if (isTarget) {
          caption = `Visit ${ordinals[i]}→${val} — Current: ${val} · Stack: ${stacksAfter[i]} · Count: ${count - 1}→${count} · Decision: ${count}==k (${kk}) → STOP, return ${val}.`;
        } else {
          caption = `Visit ${ordinals[i]}→${val} — Current: ${val} · Stack: ${stacksAfter[i]} · Count: ${count - 1}→${count} · Decision: ${count}≠${kk}, ${rightNote[i]}.`;
        }
        out.push({ visitIdx: i, value: val, count, code, caption, skipped: pastTarget, isTarget });
      });
      out.push({
        visitIdx: kk - 1, value: target, count: kk, code: 3,
        caption: `FOUND 🎉 — Current: ${target} · Stack: ${stacksAfter[kk - 1]} · Count: ${kk} · Decision: count==k → return ${target}. Popped order ${visitOrder.slice(0, kk).join(", ")} is sorted!`,
        found: true,
      });
      return out;
    }

    function render() {
      const s = steps[idx];
      const target = visitOrder[k - 1];
      elKLabel.textContent = String(k);

      // Tree nodes
      Object.entries(nodeEls).forEach(([v, g]) => {
        const n = Number(v);
        const pos = visitOrder.indexOf(n);
        const visited = pos !== -1 && pos < k && (
          s.found || (s.visitIdx >= 0 && pos <= s.visitIdx) || (s.visitIdx === -1 && false)
        );
        // Simpler: a node counts as visited if its visit position <= current max visited.
        g.classList.remove("is-current", "is-visited", "is-found", "is-skipped");
        const curMax = s.found ? k - 1 : s.visitIdx;
        if (s.found && n === target) g.classList.add("is-found");
        else if (!s.found && s.visitIdx >= 0 && n === s.value) g.classList.add("is-current", "is-visited");
        else if (pos !== -1 && pos <= curMax) g.classList.add("is-visited");
        else if (pos !== -1 && pos > curMax && (s.found || s.visitIdx >= k - 1) && pos >= k) g.classList.add("is-skipped");
        void visited;
      });

      // Order badges
      elOrder.innerHTML = "";
      visitOrder.forEach((val, i) => {
        const c = document.createElement("span");
        const count = i + 1;
        c.className = "bsviz-chip"
          + (s.found && count <= k ? (val === target ? " is-found" : " is-visited") : "")
          + (!s.found && s.visitIdx >= 0 && count <= Math.min(s.visitIdx + 1, k) ? (count === Math.min(s.visitIdx + 1, k) && s.visitIdx + 1 <= k && count === s.count ? " is-visited" : " is-visited") : "")
          + ((s.found && count > k) || (!s.found && s.visitIdx >= k) && count > k ? " is-skipped" : "");
        c.textContent = `${ordinals[i]}→${val}`;
        elOrder.appendChild(c);
      });

      elFoundLabel.textContent = s.found ? `✓ kth (k=${k}) = ${target}` : (s.visitIdx >= 0 ? `count=${Math.min(s.count, k)} / k=${k}` : `count=0 / k=${k}`);

      elCaption.innerHTML = `Step ${idx + 1}/${steps.length} — ${s.caption}`;
      elCaption.classList.toggle("is-found", !!s.found);
      elSlider.max = String(steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${steps.length}`;

      codeRows.forEach((r) => r.classList.toggle("is-on", Number(r.dataset.code) === s.code));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (idx >= steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    root.querySelectorAll("[data-k]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-k]").forEach((x) => x.classList.remove("is-active"));
        b.classList.add("is-active");
        k = Number(b.dataset.k);
        stop();
        steps = buildSteps(k);
        idx = 0;
        render();
      });
    });

    // Quiz
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === "b") {
          b.classList.add("is-right");
          feedback.textContent = "✓ Correct — every left descendant < node < every right descendant, so inorder is sorted.";
        } else if (b.dataset.quiz === "a") {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ Opposite — inorder visits the smallest first (far left), biggest last.";
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ The stack is just the mechanism — the BST ordering is what sorts.";
        }
      });
    });

    // keyboard: ←/→ when focused inside viz
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    steps = buildSteps(k);
    idx = 0;
    render();
  }

  function initAll() {
    document.querySelectorAll("[data-bsviz]").forEach(initBSTViz);
  }
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
