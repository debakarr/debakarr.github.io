---
// TreeTraversalVisualizer.astro
// Step-through player for binary-tree traversals (preorder / inorder / postorder).
// Fixed shared tree: 1 root; 2,3 children; 4,5 under 2. No dependencies,
// vanilla JS, dark-mode aware, keyboard accessible, multi-instance safe.
interface Props {
  mode?: "preorder" | "inorder" | "postorder";
  id?: string;
}
const { mode = "preorder", id = `treetrav-${mode}` } = Astro.props;

const META = {
  preorder: {
    kicker: "Interactive visual · Preorder walk",
    title: "Node first, then children — can you feel the order?",
    sub: "Preorder records each node BEFORE its children: visit 1, dive left (2, 4, 5), then swing right (3). Watch the badges land 1st → 5th.",
  },
  inorder: {
    kicker: "Interactive visual · Inorder walk",
    title: "Left, node, right — the middle matters",
    sub: "Inorder records each node BETWEEN its children: down to 4, up to 2, across to 5, back to 1, then 3. On a BST this order comes out sorted.",
  },
  postorder: {
    kicker: "Interactive visual · Postorder walk",
    title: "Children first, node last",
    sub: "Postorder records each node AFTER its children: 4 and 5 before 2, then 3, and 1 dead last. Think deleting a tree bottom-up.",
  },
} as const;
const meta = META[mode] ?? META.preorder;
---

<div class="ttviz" data-ttviz={id} data-mode={mode} tabindex="0">
  <div class="ttviz-card">
    <div class="ttviz-head">
      <div>
        <p class="ttviz-kicker">{meta.kicker}</p>
        <h3 class="ttviz-title">{meta.title}</h3>
        <p class="ttviz-sub" set:html={meta.sub} />
      </div>
      <div class="ttviz-legend" aria-label="Legend">
        <span><i class="dot dot-cur"></i>current</span>
        <span><i class="dot dot-done"></i>recorded</span>
        <span><i class="dot dot-todo"></i>not yet</span>
      </div>
    </div>

    <div class="ttviz-stage">
      <svg class="ttviz-tree" viewBox="0 0 400 245" role="img" aria-label="Binary tree with values 1 to 5">
        <line class="ttviz-edge" x1="200" y1="36" x2="110" y2="116" />
        <line class="ttviz-edge" x1="200" y1="36" x2="290" y2="116" />
        <line class="ttviz-edge" x1="110" y1="116" x2="65" y2="200" />
        <line class="ttviz-edge" x1="110" y1="116" x2="155" y2="200" />
        <g class="ttviz-node" data-node="1">
          <circle class="ring" cx="200" cy="36" r="20" />
          <text class="val" x="200" y="36">1</text>
          <g class="badge"><circle class="dot" cx="220" cy="18" r="10" /><text class="num" x="220" y="18" data-badge></text></g>
        </g>
        <g class="ttviz-node" data-node="2">
          <circle class="ring" cx="110" cy="116" r="20" />
          <text class="val" x="110" y="116">2</text>
          <g class="badge"><circle class="dot" cx="130" cy="98" r="10" /><text class="num" x="130" y="98" data-badge></text></g>
        </g>
        <g class="ttviz-node" data-node="3">
          <circle class="ring" cx="290" cy="116" r="20" />
          <text class="val" x="290" y="116">3</text>
          <g class="badge"><circle class="dot" cx="310" cy="98" r="10" /><text class="num" x="310" y="98" data-badge></text></g>
        </g>
        <g class="ttviz-node" data-node="4">
          <circle class="ring" cx="65" cy="200" r="20" />
          <text class="val" x="65" y="200">4</text>
          <g class="badge"><circle class="dot" cx="85" cy="182" r="10" /><text class="num" x="85" y="182" data-badge></text></g>
        </g>
        <g class="ttviz-node" data-node="5">
          <circle class="ring" cx="155" cy="200" r="20" />
          <text class="val" x="155" y="200">5</text>
          <g class="badge"><circle class="dot" cx="175" cy="182" r="10" /><text class="num" x="175" y="182" data-badge></text></g>
        </g>
      </svg>

      <div class="ttviz-out-wrap">
        <p class="ttviz-row-label"><span>output</span><span data-role="out-count"></span></p>
        <div class="ttviz-out" data-role="output" aria-live="polite"></div>
      </div>

      <p class="ttviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="ttviz-controls">
      <div class="ttviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="ttviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 7</span>
          <input type="range" data-role="slider" min="0" max="6" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="ttviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="ttviz-codegrid">
      <div class="ttviz-code" aria-label="Algorithm code with current line highlighted">
        <div class="ttviz-fn"><span class="ln">·</span><code>def traverse(node):</code></div>
        <div data-code="0"><span class="ln">1</span><code>traverse(node.left)    # left subtree</code></div>
        <div data-code="1"><span class="ln">2</span><code>visit(node) → output   # record value</code></div>
        <div data-code="2"><span class="ln">3</span><code>traverse(node.right)   # right subtree</code></div>
      </div>
      <div class="ttviz-quiz">
        <p class="ttviz-quiz-title">Quick check — make it stick</p>
        <p class="ttviz-quiz-q">When is the node itself recorded?</p>
        <div class="ttviz-quiz-btns">
          <button type="button" data-quiz="a">Before its children</button>
          <button type="button" data-quiz="b">Between left and right</button>
          <button type="button" data-quiz="c">After its children</button>
        </div>
        <p class="ttviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        <p class="ttviz-mnemonic">🧠 Memory hook: <strong>“PRE = node first · IN = node in the middle · POST = node last.”</strong></p>
      </div>
    </div>
  </div>
</div>

<style>
  .ttviz { margin: 1.75rem 0; }
  .ttviz:focus { outline: none; }
  .ttviz:focus-visible { outline: 2px dashed var(--accent); outline-offset: 4px; border-radius: 1rem; }
  .ttviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .ttviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .ttviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .ttviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .ttviz-sub strong, .ttviz-sub em { color: var(--ink); }
  .ttviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  @media (min-width: 720px) { .ttviz-head { grid-template-columns: 1fr auto; align-items: start; } }
  .ttviz-legend { display: flex; flex-wrap: wrap; gap: .6rem; font-family: var(--font-mono); font-size: .72rem; color: var(--muted); align-content: start; }
  .ttviz-legend .dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 999px; margin-right: .3rem; vertical-align: baseline; }
  .dot-cur { background: var(--accent); }
  .dot-done { background: #22c55e; }
  .dot-todo { border: 1.5px solid var(--line); }
  .ttviz-stage { display: grid; gap: .8rem; }
  .ttviz-tree { width: 100%; height: auto; display: block; background: var(--surface); border: 1px solid var(--line); border-radius: .8rem; padding: .4rem; }
  .ttviz-edge { stroke: var(--line); stroke-width: 2; }
  .ttviz-node .ring { fill: var(--surface-raised); stroke: var(--line); stroke-width: 1.5; transition: stroke .2s, fill .2s; }
  .ttviz-node .val { fill: var(--ink); font-weight: 800; font-size: 15px; text-anchor: middle; dominant-baseline: central; }
  .ttviz-node.is-current .ring { stroke: var(--accent); stroke-width: 3; }
  .ttviz-node.is-done .ring { stroke: #22c55e; fill: color-mix(in oklab, #22c55e 14%, var(--surface)); }
  .ttviz-node .badge { visibility: hidden; }
  .ttviz-node.is-done .badge { visibility: visible; }
  .ttviz-node .badge .dot { fill: #22c55e; }
  .ttviz-node .badge .num { fill: #fff; font-size: 10px; font-weight: 800; text-anchor: middle; dominant-baseline: central; }
  .ttviz-row-label {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: .75rem; color: var(--muted);
    margin: .2rem 0 .5rem;
  }
  .ttviz-out {
    display: flex; flex-wrap: wrap; gap: .4rem; align-items: center;
    font-family: var(--font-mono); font-size: .85rem;
    border: 1px solid var(--line); border-radius: .8rem; padding: .6rem .7rem;
    background: var(--surface); min-height: 3rem;
  }
  .ttviz-chip {
    border: 1px solid #22c55e; border-radius: .55rem; padding: .25rem .55rem;
    background: color-mix(in oklab, #22c55e 14%, var(--surface)); font-weight: 700;
  }
  .ttviz-chip.is-todo { border-style: dashed; border-color: var(--line); background: transparent; color: var(--muted); font-weight: 400; }
  .ttviz-bracket { color: var(--muted); font-weight: 700; }
  .ttviz-caption {
    margin: .1rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
  }
  .ttviz-controls { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .ttviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .ttviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .ttviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .ttviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .ttviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .ttviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .ttviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .ttviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .ttviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .ttviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .ttviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .ttviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .ttviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .ttviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .ttviz-code code { white-space: pre-wrap; }
  .ttviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .ttviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .ttviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .ttviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .ttviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .ttviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .ttviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .ttviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .ttviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .ttviz-mnemonic strong { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .ttviz-node .ring { transition: none; }
  }
</style>

<script>
  function initTreeViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";

    const mode = root.dataset.mode || "preorder";
    const ORDERS = {
      preorder: [1, 2, 4, 5, 3],
      inorder: [4, 2, 5, 1, 3],
      postorder: [4, 5, 2, 3, 1],
    };
    // Position of `visit` among the three code rows, per mode:
    // pre visits first (1,0,2) · in visits middle (0,1,2) · post visits last (0,2,1).
    const CODE_SEQ = {
      preorder: [1, 0, 2],
      inorder: [0, 1, 2],
      postorder: [0, 2, 1],
    };
    const QUIZ_ANSWER = { preorder: "a", inorder: "b", postorder: "c" };
    const QUIZ_WHY = {
      preorder: "✓ Correct — preorder records the node BEFORE its children.",
      inorder: "✓ Correct — inorder records the node BETWEEN left and right.",
      postorder: "✓ Correct — postorder records the node AFTER its children.",
    };
    const order = ORDERS[mode] || ORDERS.preorder;
    const seq = CODE_SEQ[mode] || CODE_SEQ.preorder;

    const fmt = (arr) => `[${arr.join(", ")}]`;

    // Steps: start + one per visit (5) + done.
    const steps = [
      {
        node: null, code: -1, out: [],
        caption: `Start — output is []. Press Next or Play: 5 visits, one node at a time, in ${mode} order.`,
      },
    ];
    order.forEach((v, i) => {
      const out = order.slice(0, i + 1);
      steps.push({
        node: v, code: seq[i % seq.length], out,
        caption: `At node ${v} · Action: recorded ${v} → output · Output so far: ${fmt(out)}`,
      });
    });
    steps.push({
      node: null, code: -1, out: [...order],
      caption: `Done — ${mode} output is ${fmt(order)}. The node is recorded ${mode === "preorder" ? "first" : mode === "inorder" ? "in the middle" : "last"}, every time.`,
    });

    let idx = 0;
    let timer = null;

    const nodeEls = {};
    root.querySelectorAll("[data-node]").forEach((g) => { nodeEls[g.dataset.node] = g; });
    const elOut = root.querySelector('[data-role="output"]');
    const elOutCount = root.querySelector('[data-role="out-count"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll("[data-code]")];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');

    function render() {
      const s = steps[idx];
      const badgeOf = {};
      s.out.forEach((v, i) => { badgeOf[v] = i + 1; });

      Object.entries(nodeEls).forEach(([val, g]) => {
        const v = Number(val);
        g.classList.toggle("is-current", s.node === v);
        g.classList.toggle("is-done", v in badgeOf);
        const badge = g.querySelector("[data-badge]");
        if (badge) badge.textContent = badgeOf[v] ? String(badgeOf[v]) : "";
      });

      elOut.innerHTML = "";
      const open = document.createElement("span");
      open.className = "ttviz-bracket";
      open.textContent = "[";
      elOut.appendChild(open);
      for (let i = 0; i < order.length; i++) {
        const c = document.createElement("span");
        if (i < s.out.length) {
          c.className = "ttviz-chip";
          c.textContent = String(s.out[i]);
        } else {
          c.className = "ttviz-chip is-todo";
          c.textContent = "·";
        }
        elOut.appendChild(c);
      }
      const close = document.createElement("span");
      close.className = "ttviz-bracket";
      close.textContent = "]";
      elOut.appendChild(close);
      elOutCount.textContent = s.out.length ? `${s.out.length} / ${order.length} recorded` : "empty";

      elCaption.textContent = `Step ${idx + 1}/${steps.length} — ${s.caption}`;
      elSlider.max = String(steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${steps.length}`;

      codeRows.forEach((r) => r.classList.toggle("is-on", Number(r.dataset.code) === s.code));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (idx >= steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    // Quiz — correct answer depends on mode.
    const answer = QUIZ_ANSWER[mode] || "a";
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === answer) {
          b.classList.add("is-right");
          feedback.textContent = QUIZ_WHY[mode] || QUIZ_WHY.preorder;
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ Not quite — check the mnemonic: PRE = first · IN = middle · POST = last.";
        }
      });
    });

    // keyboard: ←/→ when focused inside viz
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    render();
  }

  function initAll() {
    document.querySelectorAll("[data-ttviz]").forEach(initTreeViz);
  }
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
