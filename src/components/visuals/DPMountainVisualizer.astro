---
// DPMountainVisualizer.astro
// Step-through player for LeetCode 53: Kadane's carry-or-restart.
// No dependencies, vanilla JS, dark-mode aware, keyboard accessible.
interface Props {
  id?: string;
}
const { id = "dpmountain-main" } = Astro.props;
---

<div class="dpmviz" data-dpmviz={id} tabindex="0" aria-label="Maximum subarray interactive visual. Use left and right arrow keys to step.">
  <div class="dpmviz-card">
    <div class="dpmviz-head">
      <div>
        <p class="dpmviz-kicker">Interactive visual · Carry or Restart</p>
        <h3 class="dpmviz-title">Continue the streak or start over?</h3>
        <p class="dpmviz-sub">
          Carry the best streak <strong>ending here</strong> as you walk left → right.
          At each number you only have two moves:
          <em>continue</em> the streak (<code>carry + num</code>) or
          <em>restart</em> fresh at <code>num</code>. Keep the best you ever saw.
        </p>
      </div>
      <div class="dpmviz-bestbox" aria-live="polite">
        <span class="dpmviz-best-label">best so far</span>
        <strong data-role="best">—</strong>
        <span class="dpmviz-best-badge" data-role="best-badge" hidden>★ new best</span>
      </div>
    </div>

    <div class="dpmviz-stage">
      <div class="dpmviz-row-label">
        <span>nums</span>
        <span class="dpmviz-carry-label">carry = <strong data-role="carry">—</strong></span>
      </div>
      <div class="dpmviz-bars" data-role="bars" aria-live="polite"></div>

      <div class="dpmviz-mid">
        <div class="dpmviz-decision" data-role="decision" aria-live="polite"></div>
      </div>

      <p class="dpmviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="dpmviz-controls">
      <div class="dpmviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="dpmviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 1</span>
          <input type="range" data-role="slider" min="0" max="0" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="dpmviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="dpmviz-codegrid">
      <div class="dpmviz-code" aria-label="Algorithm code with current line highlighted">
        <div data-code="0"><span class="ln">1</span><code>carry = best = nums[0]</code></div>
        <div data-code="1"><span class="ln">2</span><code>carry = max(num, carry+num)  # continue or restart</code></div>
        <div data-code="2"><span class="ln">3</span><code>best = max(best, carry)</code></div>
      </div>
      <div class="dpmviz-quiz">
        <p class="dpmviz-quiz-title">Quick check — make it stick</p>
        <p class="dpmviz-quiz-q">carry = −4 and num = 4. What now?</p>
        <div class="dpmviz-quiz-btns">
          <button type="button" data-quiz="a">Continue to 0</button>
          <button type="button" data-quiz="b">Restart at 4</button>
        </div>
        <p class="dpmviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        <p class="dpmviz-mnemonic">🧠 Memory hook: <strong>“Continue the streak or start over?”</strong> Carry helps only while it stays positive — otherwise drop it and restart.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .dpmviz { margin: 1.75rem 0; }
  .dpmviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .dpmviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .dpmviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .dpmviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .dpmviz-sub strong, .dpmviz-sub em { color: var(--ink); }
  .dpmviz-sub code { font-family: var(--font-mono); font-size: .82rem; color: var(--ink); }
  .dpmviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  @media (min-width: 720px) { .dpmviz-head { grid-template-columns: 1fr auto; align-items: start; } }
  .dpmviz-bestbox {
    border: 1px solid var(--line); border-radius: .8rem;
    background: var(--surface); padding: .6rem .8rem;
    font-family: var(--font-mono); font-size: .8rem; color: var(--muted);
    display: flex; align-items: center; gap: .5rem; white-space: nowrap;
  }
  .dpmviz-bestbox strong { color: var(--accent-strong); font-size: 1.05rem; }
  .dpmviz-best-label { text-transform: uppercase; letter-spacing: .07em; font-size: .68rem; }
  .dpmviz-best-badge {
    font-size: .68rem; font-weight: 700;
    border: 1px solid #22c55e; color: #16a34a; border-radius: 999px;
    padding: .1rem .5rem; background: color-mix(in oklab, #22c55e 12%, transparent);
  }
  .dpmviz-row-label {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: .75rem; color: var(--muted);
    margin: .2rem 0 .5rem;
  }
  .dpmviz-carry-label strong { color: var(--accent-strong); font-size: .95rem; }
  .dpmviz-bars { display: flex; gap: .45rem; }
  .dpmviz-col {
    flex: 1 1 0; min-width: 0; text-align: center;
    border: 1.5px solid var(--line); border-radius: .7rem;
    padding: .4rem .25rem .45rem; background: var(--surface);
    transition: transform .2s, border-color .2s, background .2s;
  }
  .dpmviz-col .v { font-weight: 800; font-size: .95rem; display: block; font-family: var(--font-mono); }
  .dpmviz-col .i { font-family: var(--font-mono); font-size: .65rem; color: var(--muted); display: block; }
  .dpmviz-track {
    position: relative; height: 104px; margin: .35rem 0;
    background: var(--surface-raised);
    border: 1px solid var(--line); border-radius: .5rem; overflow: hidden;
  }
  .dpmviz-axis { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--line); }
  .dpmviz-bar { position: absolute; left: 20%; right: 20%; border-radius: 3px; min-height: 3px; }
  .dpmviz-bar.is-pos { background: var(--accent); }
  .dpmviz-bar.is-neg { background: color-mix(in oklab, #ef4444 80%, var(--muted)); }
  .dpmviz-col.is-current { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 6px 18px -10px var(--accent); }
  .dpmviz-col.is-win { border-color: #22c55e; background: color-mix(in oklab, #22c55e 14%, var(--surface)); }
  .dpmviz-col.is-win .dpmviz-bar { background: #22c55e !important; }
  .dpmviz-col.is-dim { opacity: .6; }
  .dpmviz-carry-chip {
    display: inline-block; margin-top: .3rem;
    font-family: var(--font-mono); font-size: .65rem;
    border: 1px solid var(--line); border-radius: .45rem; padding: .08rem .35rem;
    color: var(--muted); background: var(--surface-raised);
  }
  .dpmviz-carry-chip.is-on { border-color: var(--accent); color: var(--accent-strong); font-weight: 700; }
  .dpmviz-carry-chip.is-neg { color: var(--muted); }
  .dpmviz-mid { display: grid; gap: .9rem; margin-top: 1rem; }
  .dpmviz-decision {
    border: 1px solid var(--line); border-radius: .8rem; padding: .7rem .8rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
    display: grid; gap: .55rem;
  }
  @media (min-width: 720px) { .dpmviz-decision { grid-template-columns: 1fr 1fr 1fr; align-items: stretch; } }
  .dpmviz-opt {
    border: 1.5px solid var(--line); border-radius: .65rem; padding: .5rem .6rem;
    background: var(--surface-raised);
  }
  .dpmviz-opt .k { font-family: var(--font-mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); display: block; margin-bottom: .15rem; }
  .dpmviz-opt .val { font-family: var(--font-mono); font-size: .85rem; }
  .dpmviz-opt .val strong { color: var(--ink); }
  .dpmviz-opt.is-winner { border-color: #22c55e; background: color-mix(in oklab, #22c55e 12%, var(--surface-raised)); }
  .dpmviz-opt.is-winner .val strong { color: #16a34a; }
  .dpmviz-opt.is-loser { opacity: .65; }
  .dpmviz-bestline .val strong { color: var(--accent-strong); }
  .dpmviz-caption {
    margin: .9rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
  }
  .dpmviz-controls { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .dpmviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .dpmviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .dpmviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .dpmviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .dpmviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .dpmviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .dpmviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .dpmviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .dpmviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .dpmviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .dpmviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .dpmviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .dpmviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .dpmviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .dpmviz-code code { white-space: pre-wrap; }
  .dpmviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .dpmviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .dpmviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .dpmviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .dpmviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .dpmviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .dpmviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .dpmviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .dpmviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .dpmviz-mnemonic strong { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) { .dpmviz-col { transition: none; } }
</style>

<script>
  function initDPMountainViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";

    const nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4];
    const maxAbs = Math.max(...nums.map((n) => Math.abs(n)), 1);
    let steps = [];
    let idx = 0;
    let timer = null;

    const elBars = root.querySelector('[data-role="bars"]');
    const elBest = root.querySelector('[data-role="best"]');
    const elBestBadge = root.querySelector('[data-role="best-badge"]');
    const elCarry = root.querySelector('[data-role="carry"]');
    const elDecision = root.querySelector('[data-role="decision"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll('[data-code]')];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function buildSteps(arr) {
      const out = [];
      out.push({
        type: "start", i: -1, num: null, prevCarry: null, cont: null,
        carry: null, best: null, decision: null, isNewBest: false,
        carryStart: -1, bestStart: 0, bestEnd: 0, carryHist: [], code: 0,
        caption: "Carry in: — · Options: — · Decision: ready — the first number sets both · Best: —. Press Next or Play.",
      });
      let carry = arr[0];
      let best = arr[0];
      let carryStart = 0;
      let bestStart = 0;
      let bestEnd = 0;
      const hist = [];
      for (let i = 0; i < arr.length; i++) {
        const num = arr[i];
        if (i === 0) {
          hist.push(carry);
          out.push({
            type: "step", i, num, prevCarry: null, cont: null,
            carry, best, decision: "restart", isNewBest: true,
            carryStart, bestStart, bestEnd, carryHist: [...hist], code: 0,
            caption: `Carry in: start · Options: none yet · Decision: restart — carry = best = ${num} · Best: ${best}`,
          });
          continue;
        }
        const prev = carry;
        const prevStart = carryStart;
        const cont = prev + num;
        const decision = cont >= num ? "continue" : "restart";
        carry = decision === "continue" ? cont : num;
        carryStart = decision === "continue" ? prevStart : i;
        const isNewBest = carry > best;
        if (isNewBest) {
          best = carry;
          bestStart = carryStart;
          bestEnd = i;
        }
        hist.push(carry);
        const code = isNewBest ? 2 : 1;
        out.push({
          type: "step", i, num, prevCarry: prev, cont,
          carry, best, decision, isNewBest,
          carryStart, bestStart, bestEnd, carryHist: [...hist], code,
          caption: `Carry in: ${prev} · Options: continue ${prev}+${num}=${cont} vs restart ${num} · Decision: ${decision} → carry=${carry} · Best: ${best}${isNewBest ? " ★ new best" : ""}`,
        });
      }
      const win = arr.slice(bestStart, bestEnd + 1);
      out.push({
        type: "done", i: arr.length - 1, num: arr[arr.length - 1],
        prevCarry: null, cont: null, carry, best, decision: null,
        isNewBest: false, carryStart, bestStart, bestEnd,
        carryHist: [...hist], code: 2,
        caption: `Done — best=${best} from [${bestStart}..${bestEnd}] = [${win.join(",")}]. The winner [4,-1,2,1] stays green.`,
      });
      return out;
    }

    function render() {
      const s = steps[idx];
      const isDone = s.type === "done";

      elBest.textContent = s.best == null ? "—" : String(s.best);
      if (elBestBadge) elBestBadge.hidden = !(s.isNewBest || isDone);
      elCarry.textContent = s.carry == null ? "—" : String(s.carry);

      elBars.innerHTML = "";
      nums.forEach((n, j) => {
        const col = document.createElement("div");
        const inWin = isDone && j >= s.bestStart && j <= s.bestEnd;
        let cls = "dpmviz-col"
          + (s.i === j ? " is-current" : "")
          + (inWin ? " is-win" : "")
          + (s.i >= 0 && j > s.i ? " is-dim" : "");
        col.className = cls;
        const h = (Math.abs(n) / maxAbs) * 50;
        const barCls = n >= 0 ? "dpmviz-bar is-pos" : "dpmviz-bar is-neg";
        const barStyle = n >= 0
          ? `bottom:50%;height:${h}%;`
          : `top:50%;height:${h}%;`;
        const carryVal = j < s.carryHist.length ? s.carryHist[j] : null;
        const carryOn = s.i === j && carryVal != null;
        col.innerHTML =
          `<span class="v">${n}</span>` +
          `<div class="dpmviz-track"><div class="dpmviz-axis"></div>` +
          `<div class="${barCls}" style="${barStyle}"></div></div>` +
          `<span class="i">idx ${j}</span><br/>` +
          (carryVal != null
            ? `<span class="dpmviz-carry-chip${carryOn ? " is-on" : ""}${carryVal < 0 ? " is-neg" : ""}">c=${carryVal}</span>`
            : `<span class="dpmviz-carry-chip">c=·</span>`);
        elBars.appendChild(col);
      });

      if (s.type === "start") {
        elDecision.innerHTML =
          `<div class="dpmviz-opt"><span class="k">Carry in</span><span class="val">—</span></div>` +
          `<div class="dpmviz-opt"><span class="k">Continue vs Restart</span><span class="val">press <strong>Next</strong> to walk</span></div>` +
          `<div class="dpmviz-opt dpmviz-bestline"><span class="k">Best</span><span class="val">—</span></div>`;
      } else if (isDone) {
        const win = nums.slice(s.bestStart, s.bestEnd + 1);
        elDecision.innerHTML =
          `<div class="dpmviz-opt is-winner"><span class="k">🏆 Winner</span><span class="val"><strong>[${win.join(", ")}] = ${s.best}</strong></span></div>` +
          `<div class="dpmviz-opt"><span class="k">Carry out</span><span class="val"><strong>${s.carry}</strong></span></div>` +
          `<div class="dpmviz-opt dpmviz-bestline"><span class="k">Best</span><span class="val"><strong>${s.best}</strong> @ [${s.bestStart}..${s.bestEnd}]</span></div>`;
      } else if (s.i === 0) {
        elDecision.innerHTML =
          `<div class="dpmviz-opt is-winner"><span class="k">Carry in</span><span class="val"><strong>start → ${s.num}</strong></span></div>` +
          `<div class="dpmviz-opt is-winner"><span class="k">Restart</span><span class="val"><strong>${s.num}</strong> (first element)</span></div>` +
          `<div class="dpmviz-opt dpmviz-bestline"><span class="k">Best</span><span class="val"><strong>${s.best}</strong></span></div>`;
      } else {
        const contWin = s.decision === "continue";
        elDecision.innerHTML =
          `<div class="dpmviz-opt${contWin ? " is-winner" : " is-loser"}"><span class="k">Continue</span><span class="val">carry+num = ${s.prevCarry}+${s.num} = <strong>${s.cont}</strong>${contWin ? " ✓" : ""}</span></div>` +
          `<div class="dpmviz-opt${!contWin ? " is-winner" : " is-loser"}"><span class="k">Restart</span><span class="val">num = <strong>${s.num}</strong>${!contWin ? " ✓" : ""}</span></div>` +
          `<div class="dpmviz-opt dpmviz-bestline"><span class="k">Best</span><span class="val"><strong>${s.best}</strong>${s.isNewBest ? " ★ new" : ""}</span></div>`;
      }

      elCaption.textContent = `Step ${idx + 1}/${steps.length} — ${s.caption}`;
      elSlider.max = String(steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${steps.length}`;

      codeRows.forEach((r) => r.classList.toggle("is-on", Number(r.dataset.code) === s.code));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (reducedMotion) {
        // Respect reduced motion: advance a single step, no autoplay.
        idx = Math.min(steps.length - 1, idx + 1);
        render();
        return;
      }
      if (idx >= steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    // Quiz: restart at 4 is correct (4 > -4+4=0)
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === "b") {
          b.classList.add("is-right");
          feedback.textContent = "✓ Correct — 4 beats −4+4=0. Drop the dead carry and restart.";
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ Not quite — continuing gives 0, restarting gives 4. Take the 4.";
        }
      });
    });

    // keyboard: ←/→ when focused inside viz
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    steps = buildSteps(nums);
    idx = 0;
    render();
  }

  function initAll() {
    document.querySelectorAll("[data-dpmviz]").forEach(initDPMountainViz);
  }
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
