---
// BacktrackVisualizer.astro
// Step-through player for backtracking choice trees. Two modes:
//   permute — LeetCode 46, [1,2,3] choice tree with used-set panel, 6 leaves.
//   paren   — LeetCode 22, n=3 tree with pruned invalid branches, 5 valid leaves.
// Decided to keep DecisionTreeVisualizer.astro (subsets) untouched and put
// both modes here. No dependencies, vanilla JS, dark-mode aware,
// keyboard accessible, multi-instance safe.
interface Props {
  mode?: "permute" | "paren";
  id?: string;
}
const { mode = "permute", id = `backtrack-${mode}` } = Astro.props;
---

<div class="btviz" data-btviz={id} data-mode={mode} tabindex="0">
  <div class="btviz-card">
    <div class="btviz-head">
      <div>
        <p class="btviz-kicker">
          {mode === "permute" ? "Interactive visual · Choice tree" : "Interactive visual · Pruned decision tree"}
        </p>
        <h3 class="btviz-title">
          {mode === "permute" ? "Choose an unused number, explore, undo" : "Open freely, close carefully — invalid branches die early"}
        </h3>
        <p class="btviz-sub">
          {mode === "permute"
            ? <>Every level picks one <strong>unused</strong> number. The <strong>used set</strong> is what stops repeats — pick, recurse, then <em>undo</em> so siblings can reuse the number. Six leaves, six permutations.</>
            : <>Each step adds <strong>(</strong> or <strong>)</strong>, but two rules prune the tree: open needs <strong>open &lt; n</strong>, close needs <strong>close &lt; open</strong>. Red <strong>✗ branches</strong> are rejected the moment <strong>close &gt; open</strong> — five valid leaves survive for n = 3.</>}
        </p>
      </div>
    </div>

    <div class="btviz-stage">
      <div class="btviz-tree" data-role="tree" aria-label="Backtracking choice tree"></div>

      <div class="btviz-mid">
        <div class="btviz-state" data-role="state" aria-live="polite"></div>
        <div class="btviz-result-wrap">
          <p class="btviz-row-label"><span>{mode === "permute" ? "collected permutations" : "collected valid strings"}</span><span data-role="count"></span></p>
          <div class="btviz-result" data-role="result"></div>
        </div>
      </div>

      <p class="btviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="btviz-controls">
      <div class="btviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="btviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 1</span>
          <input type="range" data-role="slider" min="0" max="0" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="btviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="btviz-codegrid">
      <div class="btviz-code" aria-label="Algorithm code with current line highlighted">
        {mode === "permute" ? (
          <>
            <div data-code="0"><span class="ln">1</span><code>for x in nums: if x not in used:  # choose</code></div>
            <div data-code="1"><span class="ln">2</span><code>  if len(path) == n: ans.append(path)  # leaf</code></div>
            <div data-code="2"><span class="ln">3</span><code>  path.pop(); used.remove(x)  # undo</code></div>
          </>
        ) : (
          <>
            <div data-code="0"><span class="ln">1</span><code>if open &lt; n: dfs(open+1, close, path + "(")</code></div>
            <div data-code="1"><span class="ln">2</span><code>if close &lt; open: dfs(open, close+1, path + ")")</code></div>
            <div data-code="2"><span class="ln">3</span><code>if open == close == n: ans.append(path)  # valid</code></div>
          </>
        )}
      </div>
      <div class="btviz-quiz">
        <p class="btviz-quiz-title">Quick check — make it stick</p>
        {mode === "permute" ? (
          <>
            <p class="btviz-quiz-q">How many permutations of 3 distinct items?</p>
            <div class="btviz-quiz-btns">
              <button type="button" data-quiz="a">9</button>
              <button type="button" data-quiz="b">6</button>
              <button type="button" data-quiz="c">3</button>
            </div>
          </>
        ) : (
          <>
            <p class="btviz-quiz-q">When may you add a closing bracket?</p>
            <div class="btviz-quiz-btns">
              <button type="button" data-quiz="a">Always</button>
              <button type="button" data-quiz="b">Only when close &lt; open</button>
              <button type="button" data-quiz="c">Only when open == n</button>
            </div>
          </>
        )}
        <p class="btviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        {mode === "permute" ? (
          <p class="btviz-mnemonic">🧠 Memory hook: <strong>“Choose → explore → undo.”</strong> The undo is the whole trick — without it, siblings can't reuse numbers.</p>
        ) : (
          <p class="btviz-mnemonic">🧠 Memory hook: <strong>“Never close more than you open.”</strong> That one check prunes every invalid branch the moment it appears.</p>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .btviz { margin: 1.75rem 0; }
  .btviz:focus { outline: none; }
  .btviz:focus-visible { outline: 2px dashed var(--accent); outline-offset: 4px; border-radius: 1rem; }
  .btviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .btviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .btviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .btviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .btviz-sub strong, .btviz-sub em { color: var(--ink); }
  .btviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  .btviz-stage { display: grid; gap: .9rem; }
  .btviz-tree {
    border: 1px solid var(--line); border-radius: .8rem;
    background: var(--surface); padding: .5rem;
    overflow-x: auto;
  }
  .btviz-tree svg { display: block; width: 100%; min-width: 560px; height: auto; }
  .btviz-edge { stroke: var(--line); stroke-width: 1.5; }
  .btviz-edge.is-on { stroke: var(--accent); stroke-width: 2.5; }
  .btviz-edge.is-pruned { stroke-dasharray: 4 3; }
  .btviz-edge-label {
    font-family: var(--font-mono); font-size: 9px; letter-spacing: .04em;
    fill: var(--muted);
  }
  .btviz-edge-label.is-on { fill: var(--accent-strong); font-weight: 700; }
  .btviz-node rect {
    fill: var(--surface-raised); stroke: var(--line); stroke-width: 1.5;
    transition: fill .2s, stroke .2s;
  }
  .btviz-node text {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    fill: var(--ink); text-anchor: middle; dominant-baseline: central;
  }
  .btviz-node.is-path rect { stroke: var(--accent); }
  .btviz-node.is-current rect {
    stroke: var(--accent); stroke-width: 2.5;
    fill: color-mix(in oklab, var(--accent) 18%, var(--surface-raised));
  }
  .btviz-node.is-done rect {
    stroke: #22c55e; stroke-width: 2;
    fill: color-mix(in oklab, #22c55e 14%, var(--surface));
  }
  .btviz-node.is-done text { fill: #16a34a; }
  .btviz-node.is-dead rect {
    stroke: #ef4444; stroke-width: 1.5; stroke-dasharray: 4 3;
    fill: color-mix(in oklab, #ef4444 10%, var(--surface));
  }
  .btviz-node.is-dead text { fill: #ef4444; }
  .btviz-mid { display: grid; gap: .9rem; }
  @media (min-width: 720px) { .btviz-mid { grid-template-columns: 1fr 1fr; } }
  .btviz-state {
    border: 1px dashed var(--line); border-radius: .8rem; padding: .8rem .9rem;
    font-size: .88rem; line-height: 1.55; background: color-mix(in oklab, var(--accent) 7%, transparent);
    min-height: 5.2rem;
  }
  .btviz-state strong { color: var(--accent-strong); }
  .btviz-state code { font-family: var(--font-mono); font-size: .8rem; }
  .btviz-state .good { color: #16a34a; font-weight: 700; }
  .btviz-state .bad { color: #ef4444; font-weight: 700; }
  .btviz-row-label {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: .75rem; color: var(--muted);
    margin: .2rem 0 .5rem;
  }
  .btviz-result {
    display: flex; flex-wrap: wrap; gap: .4rem; min-height: 3.2rem;
    border: 1px solid var(--line); border-radius: .8rem; padding: .6rem;
    background: var(--surface);
  }
  .btviz-chip {
    font-family: var(--font-mono); font-size: .75rem;
    border: 1px solid #22c55e; border-radius: .55rem; padding: .3rem .5rem;
    background: color-mix(in oklab, #22c55e 12%, var(--surface-raised));
    color: var(--ink);
  }
  .btviz-empty { font-size: .8rem; color: var(--muted); }
  .btviz-caption {
    margin: .1rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
    font-family: var(--font-mono); font-size: .82rem;
  }
  .btviz-controls { margin-top: .1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .btviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .btviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .btviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .btviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .btviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .btviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .btviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .btviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .btviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .btviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .btviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .btviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .btviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .btviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .btviz-code code { white-space: pre-wrap; }
  .btviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .btviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .btviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .btviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .btviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .btviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .btviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .btviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .btviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .btviz-mnemonic strong { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .btviz-node rect { transition: none; }
  }
</style>

<script>
  function initBacktrackViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";
    const mode = root.dataset.mode || "permute";

    const cfg = mode === "paren" ? buildParen() : buildPermute();

    let idx = 0;
    let timer = null;

    const elTree = root.querySelector('[data-role="tree"]');
    const elState = root.querySelector('[data-role="state"]');
    const elResult = root.querySelector('[data-role="result"]');
    const elCount = root.querySelector('[data-role="count"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll('[data-code]')];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');

    const byId = Object.fromEntries(cfg.nodes.map((n) => [n.id, n]));

    function chainTo(id) {
      const chain = [];
      let cur = id;
      while (cur !== undefined && cur !== -1) {
        chain.unshift(cur);
        cur = cfg.parent[cur];
      }
      return chain;
    }
    function esc(s) {
      return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function render() {
      const s = cfg.steps[idx];
      const chain = chainTo(s.nodeId);
      const chainSet = new Set(chain);
      const doneSet = new Set(s.doneIds || []);
      const deadSet = new Set(s.deadIds || []);

      let svg = `<svg viewBox="${cfg.viewBox}" role="img" aria-label="Choice tree">`;
      cfg.edges.forEach((e) => {
        const a = byId[e.from], b = byId[e.to];
        const on = chainSet.has(e.from) && chainSet.has(e.to);
        const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
        const lx = mx + (e.side === "L" ? -14 : 14);
        svg += `<line class="btviz-edge${on ? " is-on" : ""}${e.pruned ? " is-pruned" : ""}" x1="${a.x}" y1="${a.y + cfg.nh / 2}" x2="${b.x}" y2="${b.y - cfg.nh / 2}"/>`;
        svg += `<text class="btviz-edge-label${on ? " is-on" : ""}" x="${lx}" y="${my}">${esc(e.label)}</text>`;
      });
      cfg.nodes.forEach((n) => {
        const cls = "btviz-node"
          + (n.id === s.nodeId ? " is-current" : "")
          + (n.id !== s.nodeId && chainSet.has(n.id) ? " is-path" : "")
          + (doneSet.has(n.id) ? " is-done" : "")
          + (deadSet.has(n.id) ? " is-dead" : "");
        svg += `<g class="${cls}"><rect x="${n.x - cfg.nw / 2}" y="${n.y - cfg.nh / 2}" width="${cfg.nw}" height="${cfg.nh}" rx="12"/><text x="${n.x}" y="${n.y}">${esc(n.label)}</text></g>`;
      });
      svg += `</svg>`;
      elTree.innerHTML = svg;

      elState.innerHTML = s.stateHTML;

      elResult.innerHTML = "";
      if (s.chips.length === 0) {
        const e = document.createElement("span");
        e.className = "btviz-empty";
        e.textContent = cfg.emptyHint;
        elResult.appendChild(e);
      } else {
        s.chips.forEach((c) => {
          const el = document.createElement("span");
          el.className = "btviz-chip";
          el.textContent = c;
          elResult.appendChild(el);
        });
      }
      elCount.textContent = s.countLabel;

      elCaption.textContent = `Step ${idx + 1}/${cfg.steps.length} — ${s.caption}`;
      elSlider.max = String(cfg.steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${cfg.steps.length}`;

      codeRows.forEach((r) => r.classList.toggle("is-on", Number(r.dataset.code) === s.code));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (idx >= cfg.steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= cfg.steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(cfg.steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    // Quiz — both modes use "b".
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === "b") {
          b.classList.add("is-right");
          feedback.textContent = mode === "paren"
            ? "✓ Correct — ')' is legal only while close < open; otherwise that branch can never recover."
            : "✓ Correct — 3·2·1 = 6. Each level has one fewer unused number.";
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = mode === "paren"
            ? "✗ Not quite — check the mnemonic: never close more than you open."
            : "✗ Not quite — level 1 has 3 choices, level 2 has 2, level 3 has 1: 3·2·1 = 6.";
        }
      });
    });

    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stop(); idx = Math.min(cfg.steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    idx = 0;
    render();
  }

  // ---- permute: [1,2,3] choice tree, used-set panel, 6 leaves ----
  function buildPermute() {
    const nodes = [
      { id: 0, x: 360, y: 30, label: "[]" },
      { id: 1, x: 180, y: 110, label: "[1]" },
      { id: 2, x: 360, y: 110, label: "[2]" },
      { id: 3, x: 540, y: 110, label: "[3]" },
      { id: 4, x: 60, y: 200, label: "[1,2]" },
      { id: 5, x: 180, y: 200, label: "[1,3]" },
      { id: 6, x: 300, y: 200, label: "[2,1]" },
      { id: 7, x: 420, y: 200, label: "[2,3]" },
      { id: 8, x: 540, y: 200, label: "[3,1]" },
      { id: 9, x: 660, y: 200, label: "[3,2]" },
      { id: 10, x: 60, y: 300, label: "[1,2,3]" },
      { id: 11, x: 180, y: 300, label: "[1,3,2]" },
      { id: 12, x: 300, y: 300, label: "[2,1,3]" },
      { id: 13, x: 420, y: 300, label: "[2,3,1]" },
      { id: 14, x: 540, y: 300, label: "[3,1,2]" },
      { id: 15, x: 660, y: 300, label: "[3,2,1]" },
    ];
    const edges = [
      { from: 0, to: 1, label: "1", side: "L" }, { from: 0, to: 2, label: "2", side: "R" }, { from: 0, to: 3, label: "3", side: "R" },
      { from: 1, to: 4, label: "2", side: "L" }, { from: 1, to: 5, label: "3", side: "R" },
      { from: 2, to: 6, label: "1", side: "L" }, { from: 2, to: 7, label: "3", side: "R" },
      { from: 3, to: 8, label: "1", side: "L" }, { from: 3, to: 9, label: "2", side: "R" },
      { from: 4, to: 10, label: "3", side: "L" }, { from: 5, to: 11, label: "2", side: "R" },
      { from: 6, to: 12, label: "3", side: "L" }, { from: 7, to: 13, label: "1", side: "R" },
      { from: 8, to: 14, label: "2", side: "L" }, { from: 9, to: 15, label: "1", side: "R" },
    ];
    const parent = { 1: 0, 2: 0, 3: 0, 4: 1, 5: 1, 6: 2, 7: 2, 8: 3, 9: 3, 10: 4, 11: 5, 12: 6, 13: 7, 14: 8, 15: 9 };
    const paths = {
      0: [], 1: [1], 2: [2], 3: [3], 4: [1, 2], 5: [1, 3], 6: [2, 1], 7: [2, 3],
      8: [3, 1], 9: [3, 2], 10: [1, 2, 3], 11: [1, 3, 2], 12: [2, 1, 3],
      13: [2, 3, 1], 14: [3, 1, 2], 15: [3, 2, 1],
    };
    const children = { 0: [1, 2, 3], 1: [4, 5], 2: [6, 7], 3: [8, 9], 4: [10], 5: [11], 6: [12], 7: [13], 8: [14], 9: [15] };
    const fmt = (p) => "[" + p.join(", ") + "]";
    const escH = (s) => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;");

    // DFS preorder arrivals (root handled as the start step).
    const order = [];
    const stack = [1, 2, 3].reverse();
    const st = [...stack];
    while (st.length) {
      const n = st.pop();
      order.push(n);
      (children[n] || []).slice().reverse().forEach((c) => st.push(c));
    }

    const steps = [{
      nodeId: 0, code: -1, doneIds: [], chips: [], countLabel: "0 / 6",
      stateHTML: `path = <code><strong>[]</strong></code> · used = <code>{}</code><br/>decision: <span>— press <strong>Next</strong> or <strong>Play</strong> to choose —</span>`,
      caption: "Start — path=[], used={}. Each level chooses one unused number. Next: choose 1, 2, or 3.",
    }];
    const collected = [];
    const doneIds = [];
    let prevPath = [];
    order.forEach((nid) => {
      const path = paths[nid];
      const isLeaf = path.length === 3;
      // Undo narration: how far back did we climb since the previous step?
      let k = 0;
      while (k < prevPath.length && k < path.length && prevPath[k] === path[k]) k++;
      const popped = prevPath.length - k;
      const undoTxt = popped > 0 ? `undo ×${popped} → back at ${fmt(path.slice(0, k))}; ` : "";
      const usedTxt = `{${path.join(", ")}}`;
      let caption, code, stateHTML;
      if (isLeaf) {
        collected.push(fmt(path));
        doneIds.push(nid);
        code = 1;
        caption = `${undoTxt}path=${fmt(path)} is full → collect it (${collected.length}/6). Then undo to find the next leaf.`;
        stateHTML = `path = <code><strong>${escH(fmt(path))}</strong></code> · used = <code>${escH(usedTxt)}</code><br/>decision: <span class="good">leaf — collect ${escH(fmt(path))}</span>`;
      } else {
        const ch = path[path.length - 1];
        code = 0;
        caption = `${undoTxt}choose ${ch} → path=${fmt(path)}. used=${usedTxt}; ${3 - path.length} choice(s) left below.`;
        stateHTML = `path = <code><strong>${escH(fmt(path))}</strong></code> · used = <code>${escH(usedTxt)}</code><br/>decision: <span>choose <strong>${ch}</strong> (unused ✓) → explore</span>`;
      }
      steps.push({
        nodeId: nid, code, doneIds: [...doneIds],
        chips: [...collected], countLabel: `${collected.length} / 6`,
        stateHTML, caption,
      });
      prevPath = path;
    });
    steps.push({
      nodeId: -1, code: 2, doneIds: [...doneIds], chips: [...collected], countLabel: "6 / 6",
      stateHTML: `path = <code><strong>[]</strong></code> · used = <code>{}</code><br/>decision: <span class="good">done — everything undone, 6 permutations kept</span>`,
      caption: "Done — 6 leaves, 6 permutations = 3!. Every undo restored a number, so no branch ever reused one.",
    });

    return {
      nodes, edges, parent, steps, nw: 66, nh: 26, viewBox: "0 0 720 342",
      emptyHint: "(empty — reach a depth-3 leaf to collect a permutation)",
    };
  }

