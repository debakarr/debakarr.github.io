---
// StockChartVisualizer.astro
// Step-through player for Best Time to Buy and Sell Stock II: collect every climb.
// No dependencies, vanilla JS + inline SVG, dark-mode aware, keyboard accessible.
interface Props {
  id?: string;
}
const { id = "stock-main" } = Astro.props;
---

<div class="stviz" data-stviz={id}>
  <div class="stviz-card">
    <div class="stviz-head">
      <div>
        <p class="stviz-kicker">Interactive visual · Collect Every Climb</p>
        <h3 class="stviz-title">When do we collect? Every upward step.</h3>
        <p class="stviz-sub">
          Walk the price chart day by day. Whenever tomorrow's price is higher
          than today's, pocket the difference. Downhill days? Just walk past —
          you can't lose money you never risked. Watch the total climb to
          <strong>7</strong> on <code>[7, 1, 5, 3, 6, 4]</code>.
        </p>
      </div>
      <div class="stviz-total" aria-live="polite">
        <span class="stviz-total-label">total profit</span>
        <strong data-role="total">0</strong>
      </div>
    </div>

    <div class="stviz-stage">
      <svg data-role="chart" viewBox="0 0 600 220" role="img" aria-label="Price chart for 7, 1, 5, 3, 6, 4"></svg>
      <div class="stviz-chips" data-role="chips" aria-live="polite"></div>
      <p class="stviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="stviz-controls">
      <div class="stviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="stviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 1</span>
          <input type="range" data-role="slider" min="0" max="0" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="stviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="stviz-codegrid">
      <div class="stviz-code" aria-label="Algorithm code with current line highlighted">
        <div data-code="0"><span class="ln">1</span><code>profit = 0</code></div>
        <div data-code="1"><span class="ln">2</span><code>for i in range(len(prices) - 1):  # compare day i, day i+1</code></div>
        <div data-code="2"><span class="ln">3</span><code>  if prices[i+1] &gt; prices[i]: profit += prices[i+1] - prices[i]</code></div>
      </div>
      <div class="stviz-quiz">
        <p class="stviz-quiz-title">Quick check — make it stick</p>
        <p class="stviz-quiz-q">When do we collect?</p>
        <div class="stviz-quiz-btns">
          <button type="button" data-quiz="a">Every up-step</button>
          <button type="button" data-quiz="b">Only the biggest jump</button>
        </div>
        <p class="stviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        <p class="stviz-mnemonic">🧠 Memory hook: <strong>“Collect every positive climb.”</strong> Any single uphill walk equals the sum of its daily climbs, so grabbing each one is the same as timing the whole valley-to-peak perfectly.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .stviz { margin: 1.75rem 0; }
  .stviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .stviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .stviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .stviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .stviz-sub strong { color: var(--ink); }
  .stviz-sub code { font-family: var(--font-mono); font-size: .82em; color: var(--ink); }
  .stviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  @media (min-width: 720px) { .stviz-head { grid-template-columns: 1fr auto; align-items: start; } }
  .stviz-total {
    text-align: center; border: 1px solid var(--line); border-radius: .8rem;
    background: var(--surface); padding: .6rem 1.2rem; min-width: 8rem;
  }
  .stviz-total-label { display: block; font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .stviz-total strong { font-size: 1.6rem; color: #16a34a; }
  .stviz-stage svg { width: 100%; height: auto; display: block; }
  .stviz-chips { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .7rem; min-height: 2rem; }
  .stviz-chip {
    font-family: var(--font-mono); font-size: .75rem; font-weight: 700;
    border: 1px solid #22c55e; border-radius: .55rem; padding: .3rem .5rem;
    background: color-mix(in oklab, #22c55e 14%, var(--surface)); color: #16a34a;
  }
  .stviz-chip.is-skip {
    border-color: var(--line); color: var(--muted);
    background: var(--surface); font-weight: 400;
  }
  .stviz-empty { font-size: .8rem; color: var(--muted); }
  .stviz-caption {
    margin: .9rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
  }
  .stviz-controls { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .stviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .stviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .stviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .stviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .stviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .stviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .stviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .stviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .stviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .stviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .stviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .stviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .stviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .stviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .stviz-code code { white-space: pre-wrap; }
  .stviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .stviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .stviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .stviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .stviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .stviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .stviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .stviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .stviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .stviz-mnemonic strong { color: var(--ink); }
</style>

<script>
  function initStockViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";

    const prices = [7, 1, 5, 3, 6, 4];
    const steps = [
      { code: 0, seg: -1, total: 0, caption: "Start with profit = 0. We walk day by day, comparing each day to the next." },
      { code: 1, seg: 0, total: 0, caption: "Day 0 → 1: 7 → 1, downhill. No trade — you can't lose what you never buy. Profit stays 0." },
      { code: 2, seg: 1, total: 4, caption: "Day 1 → 2: 1 → 5, uphill! Buy at 1, sell at 5: +4. Profit = 4. 🟢" },
      { code: 1, seg: 2, total: 4, caption: "Day 2 → 3: 5 → 3, downhill. Walk past, keep the 4." },
      { code: 2, seg: 3, total: 7, caption: "Day 3 → 4: 3 → 6, uphill! Buy at 3, sell at 6: +3. Profit = 7. 🟢" },
      { code: 1, seg: 4, total: 7, caption: "Day 4 → 5: 6 → 4, downhill. Done — total profit 7, matching buy-at-1-sell-at-5 + buy-at-3-sell-at-6." },
    ];
    const NS = "http://www.w3.org/2000/svg";
    const W = 600, H = 220, PAD = 36;
    const min = Math.min(...prices), max = Math.max(...prices);
    const X = (i) => PAD + (i * (W - 2 * PAD)) / (prices.length - 1);
    const Y = (p) => H - PAD - ((p - min) * (H - 2 * PAD)) / (max - min || 1);

    let idx = 0;
    let timer = null;

    const svg = root.querySelector('[data-role="chart"]');
    const elChips = root.querySelector('[data-role="chips"]');
    const elTotal = root.querySelector('[data-role="total"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll('[data-code]')];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');

    function render() {
      const s = steps[idx];
      svg.innerHTML = "";

      // gridlines + y labels
      for (let p = min; p <= max; p++) {
        const ln = document.createElementNS(NS, "line");
        ln.setAttribute("x1", PAD); ln.setAttribute("x2", W - 12);
        ln.setAttribute("y1", Y(p)); ln.setAttribute("y2", Y(p));
        ln.setAttribute("stroke", "var(--line)"); ln.setAttribute("stroke-width", "1");
        ln.setAttribute("opacity", "0.6");
        svg.appendChild(ln);
        const t = document.createElementNS(NS, "text");
        t.setAttribute("x", 4); t.setAttribute("y", Y(p) + 4);
        t.setAttribute("font-size", "11"); t.setAttribute("fill", "var(--muted)");
        t.setAttribute("font-family", "var(--font-mono)");
        t.textContent = String(p);
        svg.appendChild(t);
      }

      // segments: full path dim, revealed up-segments green
      for (let i = 0; i < prices.length - 1; i++) {
        const up = prices[i + 1] > prices[i];
        const revealed = i <= s.seg;
        const ln = document.createElementNS(NS, "line");
        ln.setAttribute("x1", X(i)); ln.setAttribute("y1", Y(prices[i]));
        ln.setAttribute("x2", X(i + 1)); ln.setAttribute("y2", Y(prices[i + 1]));
        ln.setAttribute("stroke-width", revealed && up ? "4" : "2.5");
        ln.setAttribute("stroke-linecap", "round");
        if (!revealed) {
          ln.setAttribute("stroke", "var(--line)");
          ln.setAttribute("stroke-dasharray", "5 4");
        } else if (up) {
          ln.setAttribute("stroke", "#22c55e");
        } else {
          ln.setAttribute("stroke", "var(--muted)");
          ln.setAttribute("opacity", "0.7");
        }
        svg.appendChild(ln);

        // +profit chip on revealed up-segments
        if (revealed && up) {
          const diff = prices[i + 1] - prices[i];
          const t = document.createElementNS(NS, "text");
          t.setAttribute("x", (X(i) + X(i + 1)) / 2);
          t.setAttribute("y", Math.min(Y(prices[i]), Y(prices[i + 1])) - 8);
          t.setAttribute("text-anchor", "middle");
          t.setAttribute("font-size", "13"); t.setAttribute("font-weight", "700");
          t.setAttribute("fill", "#16a34a");
          t.setAttribute("font-family", "var(--font-mono)");
          t.textContent = `+${diff}`;
          svg.appendChild(t);
        }
      }

      // day dots + price labels
      prices.forEach((p, i) => {
        const c = document.createElementNS(NS, "circle");
        c.setAttribute("cx", X(i)); c.setAttribute("cy", Y(p)); c.setAttribute("r", "5");
        const active = s.seg >= 0 && (i === s.seg || i === s.seg + 1);
        c.setAttribute("fill", active ? "var(--accent)" : "var(--surface-raised)");
        c.setAttribute("stroke", active ? "var(--accent)" : "var(--muted)");
        c.setAttribute("stroke-width", "2");
        svg.appendChild(c);
        const t = document.createElementNS(NS, "text");
        t.setAttribute("x", X(i)); t.setAttribute("y", Y(p) + 20);
        t.setAttribute("text-anchor", "middle");
        t.setAttribute("font-size", "12"); t.setAttribute("font-weight", "700");
        t.setAttribute("fill", "var(--ink)");
        t.setAttribute("font-family", "var(--font-mono)");
        t.textContent = `${p} (d${i})`;
        svg.appendChild(t);
      });

      // chips row
      elChips.innerHTML = "";
      if (s.seg < 0) {
        const e = document.createElement("span");
        e.className = "stviz-empty";
        e.textContent = "No days compared yet — press Next or Play.";
        elChips.appendChild(e);
      } else {
        for (let i = 0; i <= s.seg; i++) {
          const c = document.createElement("span");
          if (prices[i + 1] > prices[i]) {
            c.className = "stviz-chip";
            c.textContent = `d${i}→d${i + 1}: +${prices[i + 1] - prices[i]}`;
          } else {
            c.className = "stviz-chip is-skip";
            c.textContent = `d${i}→d${i + 1}: skip`;
          }
          elChips.appendChild(c);
        }
      }

      elTotal.textContent = String(s.total);
      elCaption.textContent = `Step ${idx + 1}/${steps.length} — ${s.caption}`;
      elSlider.max = String(steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${steps.length}`;

      codeRows.forEach((r) => r.classList.toggle("is-on", Number(r.dataset.code) === s.code));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (idx >= steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    // Quiz
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === "a") {
          b.classList.add("is-right");
          feedback.textContent = "✓ Correct — every valley-to-peak climb is exactly the sum of its daily up-steps, so skimming each one never loses anything.";
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ Not quite — a 1→5 climb (+4) equals +1+1+1+1 daily. Skipping small climbs leaves money behind.";
        }
      });
    });

    // keyboard: ←/→ when focused inside viz
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    render();
  }

  function initAll() {
    document.querySelectorAll("[data-stviz]").forEach(initStockViz);
  }
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
