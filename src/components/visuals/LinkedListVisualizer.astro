---
// LinkedListVisualizer.astro
// Step-through player for LeetCode 206: flip each arrow backwards in place.
// No dependencies, vanilla JS, dark-mode aware, keyboard accessible.
interface Props {
  id?: string;
}
const { id = "llviz-main" } = Astro.props;
---

<div class="llviz" data-llviz={id} tabindex="0" aria-label="Reverse linked list step-through visualizer">
  <div class="llviz-card">
    <div class="llviz-head">
      <div>
        <p class="llviz-kicker">Interactive visual · Pointer Flip</p>
        <h3 class="llviz-title">Can you rewire the arrows without losing the list?</h3>
        <p class="llviz-sub">
          Each arrow can point backwards — but you need <strong>three hands</strong>:
          <em>prev</em> holds the reversed part, <em>curr</em> is the arrow being flipped,
          <em>nxt</em> keeps a grip on the untouched rest. Save → flip → advance.
        </p>
      </div>
      <div class="llviz-presets" role="group" aria-label="Choose example">
        <button type="button" data-preset="0" class="is-active">[1, 2, 3, 4, 5]</button>
        <button type="button" data-preset="1">[1, 2]</button>
      </div>
    </div>

    <div class="llviz-stage">
      <p class="llviz-row-label"><span>list (nodes stay put — only arrows move)</span></p>
      <div class="llviz-track" data-role="track" aria-live="polite"></div>
      <div class="llviz-legend" aria-hidden="true">
        <span><i class="ar fwd">→</i> unvisited</span>
        <span><i class="ar cur">→</i> cutting now</span>
        <span><i class="ar flip">←</i> reversed</span>
        <span><i class="ar sev">×</i> open gap</span>
      </div>
      <p class="llviz-caption" data-role="caption" aria-live="polite"></p>
    </div>

    <div class="llviz-controls">
      <div class="llviz-btns">
        <button type="button" data-action="prev" aria-label="Previous step">← Prev</button>
        <button type="button" data-action="play" aria-label="Play or pause">▶ Play</button>
        <button type="button" data-action="next" aria-label="Next step">Next →</button>
        <button type="button" data-action="reset" aria-label="Reset">Reset</button>
      </div>
      <div class="llviz-slider-row">
        <label>
          Step <span data-role="step-label">1 / 1</span>
          <input type="range" data-role="slider" min="0" max="0" value="0" step="1" aria-label="Scrub through steps" />
        </label>
        <label class="llviz-speed">
          Speed
          <select data-role="speed" aria-label="Playback speed">
            <option value="1400">Slow</option>
            <option value="900" selected>Normal</option>
            <option value="450">Fast</option>
          </select>
        </label>
      </div>
    </div>

    <div class="llviz-codegrid">
      <div class="llviz-code" aria-label="Algorithm code with current line highlighted">
        <div data-code="0"><span class="ln">1</span><code>prev = None</code></div>
        <div data-code="1"><span class="ln">2</span><code>curr = head</code></div>
        <div data-code="2"><span class="ln">3</span><code>nxt = curr.next  # save</code></div>
        <div data-code="3"><span class="ln">4</span><code>curr.next = prev  # flip</code></div>
        <div data-code="4"><span class="ln">5</span><code>prev, curr = curr, nxt  # advance</code></div>
      </div>
      <div class="llviz-quiz">
        <p class="llviz-quiz-title">Quick check — make it stick</p>
        <p class="llviz-quiz-q">Why save <code>nxt</code> first?</p>
        <div class="llviz-quiz-btns">
          <button type="button" data-quiz="a">It looks cleaner</button>
          <button type="button" data-quiz="b">Otherwise the rest of the list is lost</button>
          <button type="button" data-quiz="c">To save memory</button>
        </div>
        <p class="llviz-quiz-feedback" data-role="quiz-feedback" aria-live="polite"></p>
        <p class="llviz-mnemonic">🧠 Memory hook: <strong>“Save → Reverse → Advance.”</strong> Three hands, one job each: <em>nxt</em> saves, <em>curr</em> flips, <em>prev</em> + <em>curr</em> advance.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .llviz { margin: 1.75rem 0; }
  .llviz:focus { outline: none; }
  .llviz:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 1rem; }
  .llviz-card {
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--surface-raised);
    padding: 1.1rem 1.1rem 1.25rem;
    box-shadow: 0 8px 30px -18px rgba(0,0,0,.45);
  }
  .llviz-kicker {
    font-family: var(--font-mono);
    font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); margin: 0 0 .35rem;
  }
  .llviz-title { font-size: 1.05rem; font-weight: 700; margin: 0 0 .4rem; line-height: 1.35; }
  .llviz-sub { font-size: .9rem; color: var(--muted); line-height: 1.6; margin: 0; max-width: 62ch; }
  .llviz-sub strong, .llviz-sub em { color: var(--ink); }
  .llviz-head { display: grid; gap: .9rem; margin-bottom: 1rem; }
  @media (min-width: 720px) { .llviz-head { grid-template-columns: 1fr auto; align-items: start; } }
  .llviz-presets { display: flex; flex-wrap: wrap; gap: .4rem; align-content: start; }
  .llviz-presets button {
    font-family: var(--font-mono); font-size: .75rem;
    border: 1px solid var(--line); border-radius: 999px;
    padding: .35rem .7rem; color: var(--muted); background: transparent; cursor: pointer;
  }
  .llviz-presets button.is-active, .llviz-presets button:hover {
    color: var(--accent-strong); border-color: var(--accent);
  }
  .llviz-row-label {
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-mono); font-size: .75rem; color: var(--muted);
    margin: .2rem 0 .5rem;
  }
  .llviz-track {
    display: flex; align-items: stretch; gap: .3rem;
    overflow-x: auto; padding: .4rem .2rem .6rem;
  }
  .llviz-node { display: flex; flex-direction: column; align-items: center; flex: 0 0 auto; }
  .llviz-tagrow {
    min-height: 1.5rem; display: flex; align-items: center; justify-content: center; gap: .25rem;
  }
  .llviz-tag {
    font-family: var(--font-mono); font-size: .68rem; font-weight: 700;
    border: 1px solid var(--line); border-radius: 999px; padding: .05rem .5rem;
    line-height: 1.3; white-space: nowrap;
  }
  .llviz-tag.is-prev { border-color: #22c55e; color: #16a34a; }
  .llviz-tag.is-curr { background: var(--accent); border-color: var(--accent); color: white; }
  .llviz-tag.is-nxt { border-style: dashed; color: var(--muted); }
  .llviz-box {
    min-width: 3rem; text-align: center;
    border: 1.5px solid var(--line); border-radius: .7rem;
    padding: .5rem .65rem; background: var(--surface);
    font-weight: 800; font-size: 1.05rem;
    transition: transform .2s, border-color .2s, background .2s;
  }
  .llviz-box.is-stub, .llviz-box.is-null {
    border-style: dashed; font-size: .8rem; font-weight: 600;
    font-family: var(--font-mono); color: var(--muted);
  }
  .llviz-box.is-done { border-color: #22c55e; background: color-mix(in oklab, #22c55e 12%, var(--surface)); }
  .llviz-box.is-next { border-style: dashed; border-color: var(--accent); }
  .llviz-box.is-current { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 6px 18px -10px var(--accent); }
  .llviz-box.is-detached { opacity: .45; }
  .llviz-linkcol { display: flex; flex-direction: column; align-items: center; flex: 0 0 auto; }
  .llviz-arrow {
    display: flex; align-items: center; justify-content: center;
    min-width: 2.2rem; min-height: 3.1rem;
    font-size: 1.35rem; font-weight: 800; line-height: 1;
    color: var(--muted);
    transition: color .2s, transform .2s;
  }
  .llviz-arrow.is-fwd { color: var(--muted); }
  .llviz-arrow.is-current { color: var(--accent-strong); animation: llviz-pulse 1s ease-in-out infinite; }
  .llviz-arrow.is-flipped { color: #16a34a; }
  .llviz-arrow.is-severed { color: var(--muted); opacity: .6; font-size: 1rem; }
  @keyframes llviz-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.25); } }
  .llviz-legend { display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .75rem; color: var(--muted); margin-top: .3rem; }
  .llviz-legend .ar { font-style: normal; font-weight: 800; }
  .llviz-legend .fwd { color: var(--muted); }
  .llviz-legend .cur { color: var(--accent-strong); }
  .llviz-legend .flip { color: #16a34a; }
  .llviz-legend .sev { color: var(--muted); }
  .llviz-caption {
    margin: .9rem 0 0; font-size: .9rem; line-height: 1.6;
    border-left: 3px solid var(--accent); padding-left: .7rem;
  }
  .llviz-controls { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .9rem; display: grid; gap: .7rem; }
  .llviz-btns { display: flex; flex-wrap: wrap; gap: .45rem; }
  .llviz-btns button {
    border: 1px solid var(--line); border-radius: .6rem; padding: .45rem .8rem;
    font-size: .83rem; font-weight: 600; cursor: pointer;
    background: var(--surface); color: var(--ink);
  }
  .llviz-btns button:hover { border-color: var(--accent); color: var(--accent-strong); }
  .llviz-btns [data-action="play"] { background: var(--accent); border-color: var(--accent); color: white; min-width: 6.5rem; }
  .llviz-slider-row { display: grid; gap: .6rem; font-size: .8rem; color: var(--muted); }
  @media (min-width: 720px) { .llviz-slider-row { grid-template-columns: 1fr auto; align-items: center; } }
  .llviz-slider-row input[type="range"] { width: 100%; accent-color: var(--accent); }
  .llviz-speed select {
    background: var(--surface); color: var(--ink);
    border: 1px solid var(--line); border-radius: .5rem; padding: .3rem .5rem; font-size: .8rem;
  }
  .llviz-codegrid { display: grid; gap: .9rem; margin-top: 1rem; }
  @media (min-width: 860px) { .llviz-codegrid { grid-template-columns: 1.1fr .9fr; } }
  .llviz-code {
    font-family: var(--font-mono); font-size: .78rem; line-height: 1.6;
    border: 1px solid var(--line); border-radius: .8rem; overflow: hidden; background: #0d1117;
  }
  .llviz-code div { display: flex; gap: .7rem; padding: .4rem .8rem; color: #c9d1d9; opacity: .55; }
  .llviz-code div.is-on { opacity: 1; background: rgba(99,102,241,.22); border-left: 3px solid #818cf8; }
  .llviz-code .ln { color: #6e7681; min-width: 1rem; text-align: right; user-select: none; }
  .llviz-code code { white-space: pre-wrap; }
  .llviz-quiz {
    border: 1px solid var(--line); border-radius: .8rem; padding: .8rem .9rem;
    background: var(--surface); font-size: .85rem; line-height: 1.55;
  }
  .llviz-quiz-title { font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 .4rem; }
  .llviz-quiz-q { font-weight: 650; margin: 0 0 .5rem; }
  .llviz-quiz-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .llviz-quiz-btns button {
    font-size: .78rem; border: 1px solid var(--line); border-radius: 999px;
    padding: .3rem .65rem; background: var(--surface-raised); cursor: pointer; color: var(--ink);
  }
  .llviz-quiz-btns button.is-right { border-color: #22c55e; color: #16a34a; }
  .llviz-quiz-btns button.is-wrong { border-color: #ef4444; color: #ef4444; }
  .llviz-quiz-feedback { min-height: 1.4em; margin: .5rem 0 0; font-size: .82rem; }
  .llviz-mnemonic { margin: .6rem 0 0; font-size: .83rem; color: var(--muted); }
  .llviz-mnemonic strong { color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .llviz-box, .llviz-arrow { transition: none; }
    .llviz-arrow.is-current { animation: none; }
  }
</style>

<script>
  function initLinkedListViz(root) {
    if (root.dataset.init) return;
    root.dataset.init = "1";

    const presets = [[1, 2, 3, 4, 5], [1, 2]];
    let presetIdx = 0;
    let steps = [];
    let idx = 0;
    let timer = null;

    const elTrack = root.querySelector('[data-role="track"]');
    const elCaption = root.querySelector('[data-role="caption"]');
    const elSlider = root.querySelector('[data-role="slider"]');
    const elStepLabel = root.querySelector('[data-role="step-label"]');
    const elSpeed = root.querySelector('[data-role="speed"]');
    const btnPlay = root.querySelector('[data-action="play"]');
    const codeRows = [...root.querySelectorAll('[data-code]')];
    const feedback = root.querySelector('[data-role="quiz-feedback"]');

    function valOf(vals, i) {
      return i < 0 || i >= vals.length ? "None" : String(vals[i]);
    }

    function buildSteps(vals) {
      const n = vals.length;
      const out = [];
      out.push({
        phase: "start", prevIdx: -1, currIdx: 0, nxtIdx: -1, flipped: 0, code: [0, 1],
        caption: `Current: prev=None, curr=head(${vals[0]}). Decision: plant three hands — prev, curr, nxt. State: 0/${n} arrows flipped. Press Next.`,
      });
      for (let k = 0; k < n; k++) {
        const v = String(vals[k]);
        const pv = valOf(vals, k - 1);
        const w = valOf(vals, k + 1);
        const nxtIdx = k + 1 < n ? k + 1 : -1;
        out.push({
          phase: "save", prevIdx: k - 1, currIdx: k, nxtIdx, flipped: k, code: 2,
          caption: `Current: curr=${v}, prev=${pv}. Decision: save nxt=${w} first — flipping now would cut ${v}→${k + 1 < n ? w : "end"} loose forever. State: ${k}/${n} flipped.`,
        });
        out.push({
          phase: "flip", prevIdx: k - 1, currIdx: k, nxtIdx, flipped: k + 1, code: 3,
          caption: k + 1 < n
            ? `Current: curr=${v}. Decision: flip ${v}→${pv} (was ${v}→${w}). State: ${k + 1}/${n} flipped — gap now sits between ${v} and ${w}.`
            : `Current: curr=${v}. Decision: flip ${v}→${pv} (it was the tail — nothing beyond ${v}). State: ${k + 1}/${n} flipped.`,
        });
        out.push({
          phase: "advance", prevIdx: k, currIdx: k + 1, nxtIdx: k + 1 < n ? k + 1 : -1, flipped: k + 1, code: 4,
          caption: k + 1 < n
            ? `Current: prev=${v}, curr=${w}. Decision: slide both hands forward — nxt already holds ${w}. State: ${k + 1}/${n} flipped.`
            : `Current: prev=${v}, curr=None. Decision: curr fell off the end → loop exits. State: ${n}/${n} flipped.`,
        });
      }
      out.push({
        phase: "done", prevIdx: n - 1, currIdx: n, nxtIdx: -1, flipped: n, code: 4,
        caption: `Current: curr=None, prev=${vals[n - 1]}. Decision: return prev. State: ${n}/${n} flipped — new head is ${vals[n - 1]}, and ${vals[0]}→None ends the list.`,
      });
      return out;
    }

    function tagHtml(kind, label) {
      return `<span class="llviz-tag ${kind}">${label}</span>`;
    }

    function nodeHtml(vals, i, s, kind) {
      // kind: "stub" | "node" | "null"
      let above = "";
      if (s.prevIdx === i) above += tagHtml("is-prev", "prev");
      if (s.currIdx === i) above += tagHtml("is-curr", "curr");
      const below = s.nxtIdx === i ? tagHtml("is-nxt", "nxt") : "";
      let boxCls = "llviz-box";
      let label = "";
      if (kind === "stub") { boxCls += " is-stub"; label = "∅ None"; }
      else if (kind === "null") {
        boxCls += " is-null";
        label = "NULL";
        if (s.currIdx === i) boxCls += " is-current";
        if (s.flipped === vals.length) boxCls += " is-detached";
      } else {
        label = String(vals[i]);
        if (i < s.flipped) boxCls += " is-done";
        if (i === s.nxtIdx) boxCls += " is-next";
        if (i === s.currIdx) boxCls += " is-current";
      }
      return `<div class="llviz-node"><div class="llviz-tagrow">${above}</div><div class="${boxCls}">${label}</div><div class="llviz-tagrow">${below}</div></div>`;
    }

    function linkHtml(state, glyph) {
      return `<div class="llviz-linkcol"><div class="llviz-tagrow"></div><div class="llviz-arrow ${state}" aria-hidden="true">${glyph}</div><div class="llviz-tagrow"></div></div>`;
    }

    function render() {
      const vals = presets[presetIdx];
      const n = vals.length;
      const s = steps[idx];

      let html = nodeHtml(vals, -1, s, "stub");
      // stub link: ∅ ← node0 once node0 has been flipped
      html += s.flipped >= 1
        ? linkHtml("is-flipped", "←")
        : linkHtml("is-fwd", "·");
      for (let i = 0; i < n; i++) {
        html += nodeHtml(vals, i, s, "node");
        {
          // slot i sits between box i and box i+1 (box n is NULL)
          let cls, glyph;
          if (i < s.flipped - 1) { cls = "is-flipped"; glyph = "←"; }
          else if (i === s.flipped - 1) { cls = "is-severed"; glyph = "×"; }
          else { cls = "is-fwd"; glyph = "→"; }
          if (s.phase === "save" && s.currIdx === i && cls === "is-fwd") cls = "is-current";
          html += linkHtml(cls, glyph);
        }
      }
      html += nodeHtml(vals, n, s, "null");
      elTrack.innerHTML = html;

      elCaption.textContent = `Step ${idx + 1}/${steps.length} — ${s.caption}`;
      elSlider.max = String(steps.length - 1);
      elSlider.value = String(idx);
      elStepLabel.textContent = `${idx + 1} / ${steps.length}`;

      codeRows.forEach((r) => {
        const c = Number(r.dataset.code);
        const on = Array.isArray(s.code) ? s.code.includes(c) : c === s.code;
        r.classList.toggle("is-on", on);
      });
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      btnPlay.textContent = "▶ Play";
    }
    function play() {
      if (timer) { stop(); return; }
      if (idx >= steps.length - 1) idx = 0;
      btnPlay.textContent = "⏸ Pause";
      const speed = Number(elSpeed.value) || 900;
      timer = setInterval(() => {
        if (idx >= steps.length - 1) { stop(); return; }
        idx++; render();
      }, speed);
    }

    root.querySelector('[data-action="prev"]')?.addEventListener("click", () => { stop(); idx = Math.max(0, idx - 1); render(); });
    root.querySelector('[data-action="next"]')?.addEventListener("click", () => { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); });
    root.querySelector('[data-action="reset"]')?.addEventListener("click", () => { stop(); idx = 0; render(); });
    btnPlay?.addEventListener("click", play);
    elSlider?.addEventListener("input", (e) => { stop(); idx = Number(e.target.value); render(); });
    elSpeed?.addEventListener("change", () => { if (timer) { stop(); play(); } });

    root.querySelectorAll("[data-preset]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-preset]").forEach((x) => x.classList.remove("is-active"));
        b.classList.add("is-active");
        presetIdx = Number(b.dataset.preset);
        stop();
        steps = buildSteps(presets[presetIdx]);
        idx = 0;
        render();
      });
    });

    // Quiz
    root.querySelectorAll("[data-quiz]").forEach((b) => {
      b.addEventListener("click", () => {
        root.querySelectorAll("[data-quiz]").forEach((x) => x.classList.remove("is-right", "is-wrong"));
        if (b.dataset.quiz === "b") {
          b.classList.add("is-right");
          feedback.textContent = "✓ Correct — flipping curr.next destroys the only path to the rest. nxt is the backup.";
        } else {
          b.classList.add("is-wrong");
          feedback.textContent = "✗ Not quite — the flip severs curr's link forward. Without nxt saved, the rest is unreachable.";
        }
      });
    });

    // keyboard: ←/→ when focused inside viz (ignore range inputs so the slider keeps native behavior)
    root.addEventListener("keydown", (e) => {
      const t = e.target;
      if (t && (t.tagName === "INPUT" || t.tagName === "SELECT" || t.tagName === "TEXTAREA")) return;
      if (e.key === "ArrowRight") { stop(); idx = Math.min(steps.length - 1, idx + 1); render(); }
      if (e.key === "ArrowLeft") { stop(); idx = Math.max(0, idx - 1); render(); }
    });

    steps = buildSteps(presets[0]);
    idx = 0;
    render();
  }

  function initAll() {
    document.querySelectorAll("[data-llviz]").forEach(initLinkedListViz);
  }
  initAll();
  document.addEventListener("astro:page-load", initAll);
</script>
