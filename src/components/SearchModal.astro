---
---

<div id="search-modal" hidden class="fixed inset-0 z-50">
  <div
    class="absolute inset-0 bg-zinc-950/40 backdrop-blur-sm dark:bg-black/60"
    data-search-close
  ></div>
  <div
    class="relative mx-auto mt-[12vh] flex w-[calc(100%-2rem)] max-w-xl flex-col overflow-hidden rounded-2xl border border-line bg-surface-raised shadow-2xl"
  >
    <div class="flex items-center gap-3 border-b border-line px-4">
      <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-muted" aria-hidden="true">
        <path
          fill-rule="evenodd"
          d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
          clip-rule="evenodd"></path>
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Search posts…"
        autocomplete="off"
        spellcheck="false"
        class="h-13 w-full bg-transparent py-4 text-sm outline-none placeholder:text-muted"
      />
      <kbd class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-muted">esc</kbd>
    </div>
    <div id="search-results" class="max-h-[55vh] overflow-y-auto p-2" role="listbox"></div>
  </div>
</div>

<style>
  .result {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
  }
  .result:hover,
  .result[data-selected] {
    background-color: var(--surface);
  }
  .result-title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .result-excerpt {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // The site uses view transitions, so DOM is swapped between navigations while
  // module scripts run only once per session: always resolve elements lazily and
  // bind listeners on `document` so they survive swaps.
  const getModal = () => document.getElementById('search-modal');
  const getInput = () => document.getElementById('search-input') as HTMLInputElement | null;
  const getResults = () => document.getElementById('search-results');

  type Pagefind = {
    search(query: string): Promise<{
      results: {
        id: string;
        data(): Promise<{ url: string; meta?: { title?: string }; excerpt?: string }>;
      }[];
    }>;
  };
  let pagefind: Pagefind | null = null;
  let controller: AbortController | null = null;
  let selectedIndex = -1;
  let searchTimer: ReturnType<typeof setTimeout>;

  async function loadPagefind(): Promise<Pagefind | null> {
    if (pagefind) return pagefind;
    try {
      const pfUrl = '/pagefind/pagefind.js';
      pagefind = (await import(/* @vite-ignore */ pfUrl)) as unknown as Pagefind;
      return pagefind;
    } catch {
      const resultsEl = getResults();
      if (resultsEl)
        resultsEl.innerHTML =
          '<p class="px-3 py-8 text-center text-sm text-muted">Search index not found. Run <code>npm run build</code> first.</p>';
      return null;
    }
  }

  function renderResults(items: { title: string; excerpt: string; url: string }[]) {
    selectedIndex = -1;
    const resultsEl = getResults();
    if (!resultsEl) return;
    if (items.length === 0) {
      resultsEl.innerHTML = '<p class="px-3 py-8 text-center text-sm text-muted">No results found.</p>';
      return;
    }
    resultsEl.innerHTML = items
      .map(
        (item, i) => `
        <a href="${item.url}" class="result" role="option" data-index="${i}">
          <p class="result-title">${item.title}</p>
          <p class="result-excerpt">${item.excerpt}</p>
        </a>`
      )
      .join('');
  }

  function moveSelection(delta: number) {
    const resultsEl = getResults();
    if (!resultsEl) return;
    const items = [...resultsEl.querySelectorAll<HTMLAnchorElement>('.result')];
    if (items.length === 0) return;
    selectedIndex = (selectedIndex + delta + items.length) % items.length;
    items.forEach((el, i) => el.toggleAttribute('data-selected', i === selectedIndex));
    items[selectedIndex].scrollIntoView({ block: 'nearest' });
  }

  function runSearch() {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(async () => {
      const input = getInput();
      if (!input) return;
      const query = input.value.trim();
      const pf = await loadPagefind();
      if (!pf || !getInput()) return;
      controller?.abort();
      if (!query) {
        renderResults([]);
        return;
      }
      controller = new AbortController();
      const signal = controller.signal;
      const res = await pf.search(query);
      if (signal.aborted) return;
      const items = await Promise.all(
        res.results.slice(0, 10).map(async (r) => {
          const data = await r.data();
          return { title: data.meta?.title ?? data.url, excerpt: data.excerpt ?? '', url: data.url };
        })
      );
      if (signal.aborted) return;
      renderResults(items);
    }, 120);
  }

  function isOpen() {
    return getModal()?.hidden === false;
  }

  function open() {
    const modal = getModal();
    const input = getInput();
    if (!modal) return;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    if (input) {
      input.value = '';
      requestAnimationFrame(() => input.focus());
    }
    renderResults([]);
    loadPagefind();
  }
  function close() {
    const modal = getModal();
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
    controller?.abort();
  }

  document.addEventListener('click', (e) => {
    const target = e.target instanceof Element ? e.target : null;
    if (!target) return;
    if (target.closest('#search-open, #search-open-mobile')) {
      e.preventDefault();
      open();
    } else if (target.closest('[data-search-close]')) {
      close();
    }
  });

  document.addEventListener('input', (e) => {
    if (e.target instanceof HTMLInputElement && e.target.id === 'search-input') runSearch();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
    } else if (e.key === 'Escape' && isOpen()) {
      close();
    } else if (e.key === 'ArrowDown' && isOpen()) {
      e.preventDefault();
      moveSelection(1);
    } else if (e.key === 'ArrowUp' && isOpen()) {
      e.preventDefault();
      moveSelection(-1);
    } else if (e.key === 'Enter' && isOpen() && selectedIndex >= 0) {
      getResults()
        ?.querySelector<HTMLAnchorElement>(`.result[data-index="${selectedIndex}"]`)
        ?.click();
    }
  });
</script>
