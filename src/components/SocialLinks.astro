---
import { siGithub, siX, siMedium, siReddit, siDevdotto, siDiscord } from 'simple-icons';

// LinkedIn was removed from simple-icons; using the classic glyph path
const LINKEDIN_PATH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

type Icon = { label: string; href: string; path: string };

const icons: Icon[] = [
  { label: 'GitHub', href: 'https://github.com/debakarr', path: siGithub.path },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/debakar-roy', path: LINKEDIN_PATH },
  { label: 'X (Twitter)', href: 'https://twitter.com/debakar_roy', path: siX.path },
  { label: 'Medium', href: 'https://medium.com/@allinonedibakar', path: siMedium.path },
  { label: 'Reddit', href: 'https://www.reddit.com/user/Dr-NULL', path: siReddit.path },
  { label: 'Dev.to', href: 'https://dev.to/debakarroy', path: siDevdotto.path },
  { label: 'Discord', href: 'https://discordapp.com/users/191728788705509376', path: siDiscord.path },
];

const mail: Icon = {
  label: 'Email',
  href: 'mailto:debakar.roy@outlook.com',
  path: 'M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z',
};
---

<div class="flex flex-wrap items-center justify-center gap-x-1 gap-y-2">
  {
    [...icons, mail].map((icon) => (
      <a
        href={icon.href}
        title={icon.label}
        aria-label={icon.label}
        target={icon.href.startsWith('http') ? '_blank' : undefined}
        rel="noopener noreferrer me"
        class="rounded-lg p-2 text-muted transition-colors hover:bg-surface-raised hover:text-accent"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
          <path d={icon.path} />
        </svg>
      </a>
    ))
  }
</div>
