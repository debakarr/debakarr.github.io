---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

const title = 'First Contact — a language game';
const description =
  'Three alien ships arrive and nobody understands a word they say. Decode a generated alien language from context, talk back with glyph tiles, and find out why they came.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="fc-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#06080e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body data-pagefind-ignore="all">
    <div id="fc-root">
      <noscript>
        <p style="color:#e3ecf7;font-family:system-ui,sans-serif;padding:2rem">First Contact needs JavaScript to run.</p>
      </noscript>
    </div>
    <script>
      import '../../games/first-contact/main';
    </script>
  </body>
</html>
