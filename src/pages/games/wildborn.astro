---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';

const title = 'Wildborn — every creature has a history';
const description =
  'Explore an unknown world, befriend its creatures and watch their evolution shaped by the life they live: where they go, what they eat, who they fight and what they love. Breed lineages and build a collection no other player has.';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="wb-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0c1512" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body data-pagefind-ignore="all">
    <div id="wb-root">
      <noscript>
        <p style="color:#e8f3ee;font-family:system-ui,sans-serif;padding:2rem">Wildborn needs JavaScript to run.</p>
      </noscript>
    </div>
    <script>
      import '../../games/wildborn/main';
    </script>
  </body>
</html>
