---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games } from '../../data/games';

// A small decorative hex map for the card, generated at build time.
function hexMap(cols: number, rows: number, seed: number) {
  const s = 9;
  const w = Math.sqrt(3) * s;
  const palette = ['#1e3a54', '#386880', '#708c4a', '#9e9658', '#d6ba80', '#8c9280', '#7d7466'];
  const cells: { points: string; fill: string }[] = [];
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const x = w * (c + 0.5 * (r & 1)) + w / 2;
      const y = 1.5 * s * r + s;
      const nx = c / cols;
      const ny = r / rows;
      const v =
        Math.sin(nx * 7.1 + seed) * 0.5 +
        Math.cos(ny * 6.3 - seed * 0.7) * 0.4 +
        Math.sin((nx + ny) * 11.7 + seed * 1.3) * 0.25 -
        Math.abs(nx - 0.5) * 0.9;
      const idx = v < -0.35 ? 0 : v < -0.15 ? 1 : v < 0.15 ? 2 : v < 0.35 ? 3 : v < 0.5 ? 4 : v < 0.62 ? 5 : 6;
      const points = Array.from({ length: 6 }, (_, k) => {
        const a = ((60 * k - 30) * Math.PI) / 180;
        return `${(x + Math.cos(a) * (s + 0.4)).toFixed(1)},${(y + Math.sin(a) * (s + 0.4)).toFixed(1)}`;
      }).join(' ');
      cells.push({ points, fill: palette[idx] });
    }
  }
  return { cells, width: w * (cols + 0.5), height: 1.5 * s * (rows - 1) + 2 * s };
}

const art = hexMap(30, 10, 2.4);

/** A daylight skyline for Micro City: three rows of towers with lit windows. */
function skyline() {
  let seed = 11;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const W = 480;
  const H = 150;
  const rects: { x: number; y: number; w: number; h: number; fill: string }[] = [];
  const windows: { x: number; y: number }[] = [];
  const rows = [
    { base: 118, color: '#b9cde3', max: 80, w: [8, 18] },
    { base: 132, color: '#7e9cc0', max: 70, w: [12, 24] },
    { base: 150, color: '#4a6a90', max: 52, w: [14, 30] },
  ];
  for (const row of rows) {
    let x = -10;
    while (x < W + 10) {
      const bw = row.w[0] + rnd() * (row.w[1] - row.w[0]);
      const center = 1 - Math.abs(x / W - 0.55) * 1.3;
      const bh = (0.2 + rnd() * 0.8 * Math.max(0.25, center)) * row.max;
      rects.push({ x, y: row.base - bh, w: bw, h: bh + 20, fill: row.color });
      if (row.base === 150) for (let wy = row.base - bh + 5; wy < row.base - 6; wy += 6) for (let wx = x + 3; wx < x + bw - 3; wx += 5) if (rnd() < 0.45) windows.push({ x: wx, y: wy });
      x += bw + rnd() * 4;
    }
  }
  return { W, H, rects, windows };
}

/** Glowing alien glyphs over a starfield for First Contact. */
function glyphField() {
  let seed = 5;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const W = 480;
  const H = 150;
  const stars = Array.from({ length: 90 }, () => ({ x: rnd() * W, y: rnd() * H, r: 0.3 + rnd() * 0.8 }));
  const shapes = [
    'M80 50A30 30 0 1 1 20 50A30 30 0 1 1 80 50M50 47a3 3 0 1 0 0.01 0',
    'M50 18L82 76L18 76ZM30 94H70',
    'M24 24H76V76H24ZM96 38L86 50',
    'M50 15L85 50L50 85L15 50ZM50 86V98',
    'M20 30A30 30 0 0 0 80 30M50 3a3 3 0 1 0 0.01 0',
    'M20 26L50 74L80 26M32 68L68 32',
  ];
  const glyphs = Array.from({ length: 7 }, (_, k) => ({ d: shapes[(k * 5) % shapes.length], x: 70 + k * 52, y: 8 + (k % 2) * 6, s: 0.32 }));
  return { W, H, stars, glyphs };
}

/** Little organisms drifting over glowing algae for Primordial. */
function sea() {
  let seed = 9;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const W = 480;
  const H = 150;
  const blobs = Array.from({ length: 14 }, () => ({ x: rnd() * W, y: rnd() * H, r: 20 + rnd() * 40 }));
  const critters = Array.from({ length: 46 }, () => {
    const hue = [160, 95, 270, 30, 200][Math.floor(rnd() * 5)];
    return { x: rnd() * W, y: 10 + rnd() * (H - 20), r: 2 + rnd() * 3.5, a: rnd() * Math.PI * 2, hue, hunter: rnd() < 0.12 };
  });
  return { W, H, blobs, critters };
}

/** A star, its orbits and a probe's curving path for Slingshot. */
function orbits() {
  const W = 480;
  const H = 150;
  const cx = 300;
  const cy = 95;
  const rings = [36, 62, 92, 128];
  const planets = rings.map((r, k) => ({ x: cx + Math.cos(2.2 + k * 1.3) * r, y: cy + Math.sin(2.2 + k * 1.3) * r * 0.55, r: 3 + (k % 3) * 1.5, color: ['#5aa9e6', '#e07a5f', '#81b29a', '#9d8df1'][k] }));
  const stars = Array.from({ length: 70 }, (_, k) => ({ x: ((k * 7919) % 480), y: ((k * 104729) % 150), o: 0.3 + ((k * 31) % 7) / 10 }));
  return { W, H, cx, cy, rings, planets, stars };
}

/** A sunny vale with the beacon on its hill and a little fire fox for LumiQuest. */
function lumi() {
  let seed = 31;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const W = 480;
  const H = 150;
  const trees = Array.from({ length: 16 }, (_, k) => ({
    x: (k + rnd() * 0.7) * (W / 16),
    y: 104 + rnd() * 10,
    r: 6 + rnd() * 6,
    pink: rnd() < 0.25,
  }));
  const sparks = Array.from({ length: 22 }, () => ({ x: rnd() * W, y: 10 + rnd() * 70, r: 0.6 + rnd() * 1.4 }));
  const flowers = Array.from({ length: 40 }, () => ({ x: rnd() * W, y: 128 + rnd() * 20, c: ['#ffffff', '#ffd84a', '#ff8fc0', '#a88cff'][Math.floor(rnd() * 4)] }));
  return { W, H, trees, sparks, flowers };
}

/** A spiral galaxy with a bright core and a lit world for Tiny Universe. */
function cosmos() {
  let seed = 41;
  const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const W = 480;
  const H = 150;
  const cx = 250;
  const cy = 78;
  const dots: { x: number; y: number; r: number; c: string; o: number }[] = [];
  for (let k = 0; k < 420; k++) {
    const arm = k % 2;
    const t = rnd() * 3.2;
    const spread = (rnd() - 0.5) * (0.35 + t * 0.12);
    const a = t * 1.9 + arm * Math.PI + spread;
    const r = 6 + t * 46 + rnd() * 6;
    const hot = rnd() < 0.18;
    dots.push({ x: cx + Math.cos(a) * r * 1.5, y: cy + Math.sin(a) * r * 0.62, r: hot ? 1.1 : 0.6 + rnd() * 0.5, c: hot ? '#c8d4ff' : rnd() < 0.3 ? '#ffd9a8' : '#e9ecff', o: 0.35 + rnd() * 0.6 });
  }
  const field = Array.from({ length: 60 }, (_, k) => ({ x: (k * 7919) % W, y: (k * 104729) % H, o: 0.2 + ((k * 31) % 7) / 14 }));
  return { W, H, cx, cy, dots, field };
}

const city = skyline();
const field = glyphField();
const ocean = sea();
const system = orbits();
const vale = lumi();
const galaxy = cosmos();
---

<BaseLayout title="Games — Debakar Roy" description="Small games that run in your browser." wide>
  <div class="py-10">
    <h1 class="mb-2 text-3xl font-bold tracking-tight">Games</h1>
    <p class="mb-8 max-w-xl text-sm text-muted">
      Side projects that run entirely in your browser — no accounts, no servers. Your progress is saved locally and can be exported.
    </p>

    <div class="grid gap-6">
      {
        games.map((game) => (
          <a
            href={game.href}
            data-astro-reload
            class="group block overflow-hidden rounded-2xl border border-line bg-surface-raised transition-colors hover:border-accent"
          >
            <div class="relative overflow-hidden bg-[#0c1016]">
              {game.banner === 'hexmap' && (
                <svg
                  viewBox={`0 0 ${art.width.toFixed(0)} ${art.height.toFixed(0)}`}
                  class="block h-44 w-full opacity-90 transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  {art.cells.map((cell) => (
                    <polygon points={cell.points} fill={cell.fill} />
                  ))}
                </svg>
              )}
              {game.banner === 'skyline' && (
                <svg
                  viewBox={`0 0 ${city.W} ${city.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMax slice"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient id="mc-sky" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#7fc0ee" />
                      <stop offset="1" stop-color="#e3f1fa" />
                    </linearGradient>
                  </defs>
                  <rect width={city.W} height={city.H} fill="url(#mc-sky)" />
                  {city.rects.map((r) => (
                    <rect x={r.x.toFixed(1)} y={r.y.toFixed(1)} width={r.w.toFixed(1)} height={r.h.toFixed(1)} fill={r.fill} />
                  ))}
                  {city.windows.map((w) => (
                    <rect x={w.x.toFixed(1)} y={w.y.toFixed(1)} width="2" height="2.5" fill="#f6e7a8" opacity="0.8" />
                  ))}
                </svg>
              )}
              {game.banner === 'sea' && (
                <svg
                  viewBox={`0 0 ${ocean.W} ${ocean.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <defs>
                    <radialGradient id="pr-algae">
                      <stop offset="0" stop-color="#2fae6a" stop-opacity="0.55" />
                      <stop offset="1" stop-color="#2fae6a" stop-opacity="0" />
                    </radialGradient>
                  </defs>
                  <rect width={ocean.W} height={ocean.H} fill="#04192a" />
                  {ocean.blobs.map((b) => (
                    <circle cx={b.x.toFixed(1)} cy={b.y.toFixed(1)} r={b.r.toFixed(1)} fill="url(#pr-algae)" />
                  ))}
                  {ocean.critters.map((c) => (
                    <g transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)}) rotate(${((c.a * 180) / Math.PI).toFixed(0)})`}>
                      <path d={`M${(-c.r).toFixed(1)} 0 Q${(-c.r * 1.8).toFixed(1)} ${(c.r * 0.5).toFixed(1)} ${(-c.r * 2.4).toFixed(1)} 0`} stroke={`hsl(${c.hue},55%,45%)`} stroke-width="0.8" fill="none" />
                      {c.hunter ? (
                        <path d={`M${(c.r * 1.4).toFixed(1)} 0 L${(-c.r * 0.6).toFixed(1)} ${c.r.toFixed(1)} L${(-c.r * 0.3).toFixed(1)} 0 L${(-c.r * 0.6).toFixed(1)} ${(-c.r).toFixed(1)}Z`} fill="#2f8f8a" />
                      ) : (
                        <ellipse rx={(c.r * 1.15).toFixed(1)} ry={(c.r * 0.85).toFixed(1)} fill={`hsl(${c.hue},65%,62%)`} />
                      )}
                    </g>
                  ))}
                </svg>
              )}
              {game.banner === 'orbits' && (
                <svg
                  viewBox={`0 0 ${system.W} ${system.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <defs>
                    <radialGradient id="sl-sun">
                      <stop offset="0" stop-color="#fff2c4" />
                      <stop offset="0.35" stop-color="#ffc46b" />
                      <stop offset="1" stop-color="#ffc46b" stop-opacity="0" />
                    </radialGradient>
                  </defs>
                  <rect width={system.W} height={system.H} fill="#060818" />
                  {system.stars.map((s) => (
                    <circle cx={s.x} cy={s.y} r="0.6" fill="#dfe6ff" opacity={s.o} />
                  ))}
                  {system.rings.map((r) => (
                    <ellipse cx={system.cx} cy={system.cy} rx={r} ry={(r * 0.55).toFixed(1)} fill="none" stroke="#8fa0e0" stroke-opacity="0.22" stroke-width="0.7" />
                  ))}
                  <circle cx={system.cx} cy={system.cy} r="18" fill="url(#sl-sun)" />
                  <path d={`M${system.planets[1].x.toFixed(1)} ${system.planets[1].y.toFixed(1)} C 150 20, 60 60, 140 120 S 330 150, ${system.planets[3].x.toFixed(1)} ${system.planets[3].y.toFixed(1)}`} fill="none" stroke="#ffc46b" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.85" />
                  {system.planets.map((p) => (
                    <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r} fill={p.color} />
                  ))}
                </svg>
              )}
              {game.banner === 'cosmos' && (
                <svg
                  viewBox={`0 0 ${galaxy.W} ${galaxy.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <defs>
                    <radialGradient id="tu-core">
                      <stop offset="0" stop-color="#fff6e0" />
                      <stop offset="0.3" stop-color="#ffd9a8" stop-opacity="0.8" />
                      <stop offset="1" stop-color="#a9b8ff" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="tu-haze">
                      <stop offset="0" stop-color="#6f7fe0" stop-opacity="0.35" />
                      <stop offset="1" stop-color="#6f7fe0" stop-opacity="0" />
                    </radialGradient>
                    <radialGradient id="tu-world" cx="0.35" cy="0.35">
                      <stop offset="0" stop-color="#9fe0c0" />
                      <stop offset="0.6" stop-color="#3f8a8c" />
                      <stop offset="1" stop-color="#14324a" />
                    </radialGradient>
                  </defs>
                  <rect width={galaxy.W} height={galaxy.H} fill="#02030a" />
                  {galaxy.field.map((s) => (
                    <circle cx={s.x} cy={s.y} r="0.6" fill="#dfe6ff" opacity={s.o} />
                  ))}
                  <ellipse cx={galaxy.cx} cy={galaxy.cy} rx="230" ry="80" fill="url(#tu-haze)" />
                  {galaxy.dots.map((d) => (
                    <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.r.toFixed(2)} fill={d.c} opacity={d.o.toFixed(2)} />
                  ))}
                  <ellipse cx={galaxy.cx} cy={galaxy.cy} rx="34" ry="16" fill="url(#tu-core)" />
                  <circle cx="412" cy="92" r="15" fill="url(#tu-world)" />
                  <circle cx="412" cy="92" r="17" fill="none" stroke="#9fe0c0" stroke-opacity="0.35" />
                </svg>
              )}
              {game.banner === 'lumi' && (
                <svg
                  viewBox={`0 0 ${vale.W} ${vale.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMid slice"
                  aria-hidden="true"
                >
                  <defs>
                    <linearGradient id="lq-sky" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#4f9ef0" />
                      <stop offset="70%" stop-color="#bfe4ff" />
                      <stop offset="100%" stop-color="#ffe2b8" />
                    </linearGradient>
                    <radialGradient id="lq-glow" cx="0.5" cy="0.5" r="0.5">
                      <stop offset="0%" stop-color="#e8fbff" stop-opacity="0.95" />
                      <stop offset="100%" stop-color="#8ff0ff" stop-opacity="0" />
                    </radialGradient>
                  </defs>
                  <rect width={vale.W} height={vale.H} fill="url(#lq-sky)" />
                  <path d="M0 92 L40 60 L74 82 L120 40 L162 76 L200 50 L250 84 L300 46 L342 78 L390 52 L430 74 L480 58 L480 150 L0 150 Z" fill="#9fb4d8" opacity="0.7" />
                  <path d="M300 46 L314 58 L306 57 L300 52 L292 58 L286 56 Z M120 40 L134 52 L126 51 L120 46 L112 52 L106 50 Z" fill="#ffffff" opacity="0.9" />
                  <ellipse cx="96" cy="44" rx="34" ry="9" fill="#ffffff" opacity="0.75" />
                  <ellipse cx="378" cy="30" rx="44" ry="10" fill="#ffffff" opacity="0.7" />
                  <path d="M0 118 Q90 92 170 104 Q250 116 330 92 Q400 74 480 98 L480 150 L0 150 Z" fill="#6fbf4a" />
                  <path d="M190 104 Q240 66 290 100 Z" fill="#7fcf56" />
                  <rect x="236" y="54" width="10" height="34" rx="2" fill="#e8e2d2" />
                  <path d="M232 56 L250 56 L241 44 Z" fill="#3f7fd0" />
                  <circle cx="241" cy="52" r="20" fill="url(#lq-glow)" />
                  <path d="M238 52 L241 46 L244 52 L241 58 Z" fill="#bff4ff" />
                  {vale.trees.map((t) => (
                    <g>
                      <rect x={(t.x - 1).toFixed(1)} y={t.y.toFixed(1)} width="2.4" height="8" fill="#7a5236" />
                      <circle cx={t.x.toFixed(1)} cy={(t.y - 2).toFixed(1)} r={t.r.toFixed(1)} fill={t.pink ? '#ffb7d5' : '#3f8f3e'} />
                      <circle cx={(t.x - t.r * 0.3).toFixed(1)} cy={(t.y - 2 - t.r * 0.35).toFixed(1)} r={(t.r * 0.5).toFixed(1)} fill={t.pink ? '#ffd2e6' : '#6fbf4a'} />
                    </g>
                  ))}
                  <path d="M0 132 Q120 118 240 128 Q360 138 480 122 L480 150 L0 150 Z" fill="#8fd05a" />
                  {vale.flowers.map((f) => (
                    <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r="1.6" fill={f.c} />
                  ))}
                  {vale.sparks.map((s) => (
                    <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(1)} fill="#fff6c8" opacity="0.8" />
                  ))}
                  <g transform="translate(118 122)">
                    <path d="M14 6 Q30 -6 30 -22 Q22 -12 16 -10 Z" fill="#ffcf5a" />
                    <ellipse cx="0" cy="4" rx="13" ry="10" fill="#ff8a3d" />
                    <circle cx="-8" cy="-8" r="10" fill="#ff8a3d" />
                    <path d="M-16 -12 L-19 -26 L-9 -16 Z M-4 -15 L0 -28 L3 -14 Z" fill="#ff8a3d" />
                    <ellipse cx="-11" cy="-4" rx="5" ry="3.4" fill="#fff1dc" />
                    <circle cx="-12" cy="-10" r="1.9" fill="#3a1a0a" />
                    <circle cx="-5" cy="-10" r="1.9" fill="#3a1a0a" />
                  </g>
                </svg>
              )}
              {game.banner === 'glyphs' && (
                <svg
                  viewBox={`0 0 ${field.W} ${field.H}`}
                  class="block h-44 w-full transition-transform duration-500 group-hover:scale-[1.03] sm:h-56"
                  preserveAspectRatio="xMidYMin slice"
                  aria-hidden="true"
                >
                  <rect width={field.W} height={field.H} fill="#05070d" />
                  {field.stars.map((st) => (
                    <circle cx={st.x.toFixed(1)} cy={st.y.toFixed(1)} r={st.r.toFixed(2)} fill="#c8dcff" opacity="0.7" />
                  ))}
                  {field.glyphs.map((g) => (
                    <g transform={`translate(${g.x} ${g.y}) scale(${g.s})`} fill="none" stroke="#7fe3ff" stroke-linecap="round" stroke-linejoin="round">
                      <path d={g.d} stroke-width="17" opacity="0.16" />
                      <path d={g.d} stroke-width="7" />
                    </g>
                  ))}
                </svg>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-[#0c1016] via-[#0c1016]/40 to-transparent" />
              <div class="absolute bottom-4 left-5 right-5">
                <p
                  class="text-3xl font-bold tracking-[0.2em] sm:text-4xl"
                  style={`font-family: 'Iowan Old Style','Palatino Linotype',Palatino,Georgia,serif; color: ${game.accent}`}
                >
                  {game.title.toUpperCase()}
                </p>
                <p class="mt-1 font-serif text-sm italic text-zinc-300">{game.tagline}</p>
              </div>
            </div>
            <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="max-w-2xl text-sm leading-relaxed text-muted">{game.description}</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {game.tags.map((tag) => (
                    <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-muted">{tag}</span>
                  ))}
                </div>
                {game.credits && (
                  <p class="mt-3 text-xs text-muted">
                    Credits:{' '}
                    {game.credits.map((c, i) => (
                      <span>
                        {i > 0 && ' · '}
                        {c.label} ({c.license})
                      </span>
                    ))}
                  </p>
                )}
              </div>
              <span class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition group-hover:brightness-110 dark:text-zinc-950">
                {game.status === 'playable' ? 'Play' : 'Preview'}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-muted">More games are on the way.</p>
  </div>
</BaseLayout>
