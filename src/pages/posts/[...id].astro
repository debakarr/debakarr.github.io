---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime, slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : null;
const older = index < posts.length - 1 ? posts[index + 1] : null;

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
---

<BaseLayout title={`${post.data.title} — Debakar Roy`} description={post.data.description} wide>
  <article class="py-8 sm:py-10" data-pagefind-body>
    <header class="mb-10 border-b border-line pb-8">
      <div class="mb-4 flex flex-wrap gap-2" data-pagefind-ignore>
        {
          post.data.categories.map((category) => (
            <a
              href={`/categories/${slugify(category)}`}
              class="rounded-full bg-surface-raised px-2.5 py-0.5 text-xs font-medium text-muted transition-colors hover:text-accent"
            >
              {category}
            </a>
          ))
        }
      </div>
      <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl" data-pagefind-meta="title">
        {post.data.title}
      </h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted" data-pagefind-ignore>
        <time datetime={post.data.date.toISOString()} data-pagefind-meta="date">{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body ?? '')}</span>
      </p>
    </header>

    {
      toc.length > 1 && (
        <details class="toc-mobile mb-8 rounded-xl border border-line xl:hidden" data-pagefind-ignore>
          <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium">On this page</summary>
          <nav class="space-y-2 border-t border-line px-4 py-3 text-sm" aria-label="Table of contents">
            {toc.map((heading) => (
              <a
                href={`#${heading.slug}`}
                class:list={['block text-muted hover:text-accent', heading.depth === 3 && 'pl-3']}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </details>
      )
    }

    <div class="flex items-start gap-8">
      <div
        class:list={[
          'prose prose-zinc min-w-0 flex-1 max-w-none dark:prose-invert',
          'prose-headings:tracking-tight',
          'prose-p:leading-7 prose-li:leading-7',
          'prose-a:text-accent prose-a:no-underline [&_a:hover]:underline',
        ]}
      >
        <Content />
        <footer class="mt-12 flex flex-wrap gap-2 border-t border-line pt-6">
          {
            post.data.tags.map((tag) => (
              <a
                href={`/tags/${slugify(tag)}`}
                class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
              >
                #{tag}
              </a>
            ))
          }
        </footer>
      </div>

      {
        toc.length > 1 && (
          <aside
            class="sticky top-24 hidden w-48 shrink-0 xl:block"
            aria-label="Table of contents"
            data-toc
            data-pagefind-ignore
          >
            <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-muted">On this page</p>
            <nav class="max-h-[70vh] space-y-2 overflow-y-auto text-sm">
              {toc.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block text-muted transition-colors hover:text-accent',
                    heading.depth === 2 && 'font-medium',
                    heading.depth === 3 && 'pl-3',
                  ]}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
    </div>
  </article>

  <nav class="grid gap-4 border-t border-line py-10 sm:grid-cols-2" aria-label="Post navigation">
    {
      older ? (
        <a href={`/posts/${older.id}`} class="group rounded-xl border border-line p-4 transition-colors hover:border-accent">
          <span class="text-xs text-muted">← Older</span>
          <span class="mt-1 block font-medium group-hover:text-accent">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a
          href={`/posts/${newer.id}`}
          class="group rounded-xl border border-line p-4 text-right transition-colors hover:border-accent sm:col-start-2"
        >
          <span class="text-xs text-muted">Newer →</span>
          <span class="mt-1 block font-medium group-hover:text-accent">{newer.data.title}</span>
        </a>
      )
    }
  </nav>

  <script>
    function addCopyButtons() {
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.querySelector(':scope > button[data-copy]')) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.copy = '';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code');
        button.className =
          'absolute right-2.5 top-2.5 rounded-md border border-zinc-700/60 bg-zinc-800/80 px-2 py-1 text-xs text-zinc-300 backdrop-blur hover:bg-zinc-700';
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
            button.textContent = 'Copied!';
          } catch {
            button.textContent = 'Copy failed';
          }
          setTimeout(() => (button.textContent = 'Copy'), 1500);
        });
        pre.appendChild(button);
      });
    }
    addCopyButtons();
    document.addEventListener('astro:page-load', addCopyButtons);

    // Highlight the section being read in the side table of contents.
    let tocPairs: { link: HTMLAnchorElement; heading: HTMLElement }[] = [];
    let tocQueued = false;

    function updateToc() {
      tocQueued = false;
      if (tocPairs.length === 0) return;
      let active = 0;
      tocPairs.forEach((pair, i) => {
        if (pair.heading.getBoundingClientRect().top < 140) active = i;
      });
      tocPairs.forEach((pair, i) => pair.link.toggleAttribute('data-active', i === active));
    }

    function initToc() {
      tocPairs = [...document.querySelectorAll<HTMLAnchorElement>('aside[data-toc] a')].flatMap((link) => {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        return heading ? [{ link, heading }] : [];
      });
      updateToc();
    }

    initToc();
    document.addEventListener('astro:page-load', initToc);
    window.addEventListener(
      'scroll',
      () => {
        if (!tocQueued) {
          tocQueued = true;
          requestAnimationFrame(updateToc);
        }
      },
      { passive: true }
    );
  </script>

  <style is:global>
    .prose pre {
      position: relative;
      padding-top: 2rem;
    }
    /* Readable text, full-width visuals: paragraphs stay ~70ch,
       interactive visualizers / tables / code use the full column. */
    .prose > p,
    .prose > ul,
    .prose > ol {
      max-width: 70ch;
    }
    aside[data-toc] a[data-active] {
      color: var(--color-accent);
    }
    .toc-mobile summary::marker {
      color: var(--color-muted);
    }
  </style>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Debakar Roy', url: 'https://github.com/debakarr' },
  url: new URL(`/posts/${post.id}`, Astro.site).toString(),
})} />
