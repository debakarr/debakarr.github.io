---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime, slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const index = posts.findIndex((p) => p.id === post.id);
const newer = index > 0 ? posts[index - 1] : null;
const older = index < posts.length - 1 ? posts[index + 1] : null;

const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth <= 3);
---

<BaseLayout title={`${post.data.title} — Debakar Roy`} description={post.data.description}>
  <article class="py-10">
    <header class="mb-10 border-b border-line pb-8">
      <div class="mb-4 flex flex-wrap gap-2">
        {
          post.data.categories.map((category) => (
            <a
              href={`/categories/${slugify(category)}`}
              class="rounded-full bg-surface-raised px-2.5 py-0.5 text-xs font-medium text-muted transition-colors hover:text-accent"
            >
              {category}
            </a>
          ))
        }
      </div>
      <h1 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body ?? '')}</span>
      </p>
    </header>

    <div class="flex items-start gap-10">
      <div
        class:list={[
          'prose prose-zinc min-w-0 max-w-none dark:prose-invert',
          'prose-headings:tracking-tight',
          'prose-a:text-accent prose-a:no-underline hover:prose-a:underline',
        ]}
      >
        <Content />
        <footer class="mt-12 flex flex-wrap gap-2 border-t border-line pt-6">
          {
            post.data.tags.map((tag) => (
              <a
                href={`/tags/${slugify(tag)}`}
                class="rounded-full border border-line px-3 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
              >
                #{tag}
              </a>
            ))
          }
        </footer>
      </div>

      {
        toc.length > 1 && (
          <aside class="sticky top-24 hidden w-56 shrink-0 xl:block" aria-label="Table of contents">
            <p class="mb-3 font-mono text-xs font-semibold uppercase tracking-wider text-muted">On this page</p>
            <nav class="max-h-[70vh] space-y-2 overflow-y-auto text-sm">
              {toc.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    'block text-muted transition-colors hover:text-accent',
                    heading.depth === 2 && 'font-medium',
                    heading.depth === 3 && 'pl-3',
                  ]}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </aside>
        )
      }
    </div>
  </article>

  <nav class="grid gap-4 border-t border-line py-10 sm:grid-cols-2" aria-label="Post navigation">
    {
      older ? (
        <a href={`/posts/${older.id}`} class="group rounded-xl border border-line p-4 transition-colors hover:border-accent">
          <span class="text-xs text-muted">← Older</span>
          <span class="mt-1 block font-medium group-hover:text-accent">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a
          href={`/posts/${newer.id}`}
          class="group rounded-xl border border-line p-4 text-right transition-colors hover:border-accent sm:col-start-2"
        >
          <span class="text-xs text-muted">Newer →</span>
          <span class="mt-1 block font-medium group-hover:text-accent">{newer.data.title}</span>
        </a>
      )
    }
  </nav>

  <script>
    document.querySelectorAll('.prose pre').forEach((pre) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = 'Copy';
      button.className =
        'absolute right-2.5 top-2.5 rounded-md border border-zinc-700/60 bg-zinc-800/80 px-2 py-1 text-xs text-zinc-300 opacity-0 backdrop-blur transition-opacity hover:bg-zinc-700 focus-visible:opacity-100';
      pre.addEventListener('mouseenter', () => (button.style.opacity = '1'));
      pre.addEventListener('mouseleave', () => (button.style.opacity = ''));
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
        button.textContent = 'Copied!';
        setTimeout(() => (button.textContent = 'Copy'), 1500);
      });
      pre.appendChild(button);
    });
  </script>

  <style is:global>
    .prose pre {
      position: relative;
      padding-top: 2rem;
    }
  </style>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Debakar Roy', url: 'https://github.com/debakarr' },
  url: new URL(`/posts/${post.id}`, Astro.site).toString(),
})} />
