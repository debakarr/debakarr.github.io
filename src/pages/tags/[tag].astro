---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { slugify } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = new Set<string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.add(slugify(t))));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft && p.data.tags.some((t) => slugify(t) === tag))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const display = posts[0]?.data.tags.find((t) => slugify(t) === tag) ?? tag;
---

<BaseLayout title={`#${display} — Debakar Roy`} description={`Posts tagged with ${display}.`}>
  <div class="py-10">
    <a href="/tags" class="text-sm text-muted transition-colors hover:text-accent">← All topics</a>
    <h1 class="mb-2 mt-4 text-3xl font-bold tracking-tight">#{display}</h1>
    <p class="mb-8 text-sm text-muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    <PostList posts={posts} />
  </div>
</BaseLayout>
