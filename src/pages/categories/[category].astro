---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../utils';

const posts = await getCollection('posts');

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();
  posts.forEach((p) => p.data.categories.forEach((c) => categories.add(slugify(c))));
  return [...categories].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const tagged = posts
  .filter((p) => !p.data.draft && p.data.categories.some((c) => slugify(c) === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const display =
  tagged[0]?.data.categories.find((c) => slugify(c) === category) ?? category;
---

<BaseLayout title={`${display} — Debakar Roy`} description={`Posts in the ${display} category.`}>
  <div class="py-10">
    <a href="/categories" class="text-sm text-muted transition-colors hover:text-accent">← All categories</a>
    <h1 class="mb-8 mt-4 text-3xl font-bold tracking-tight">{display}</h1>
    <ul class="flex flex-col divide-y divide-line">
      {
        tagged.map((post) => (
          <li>
            <a href={`/posts/${post.id}`} class="post-row group flex items-baseline justify-between gap-4 py-3">
              <span class="truncate font-medium group-hover:text-accent">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-xs text-muted tabular-nums">
                {post.data.date.toISOString().slice(0, 10)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
