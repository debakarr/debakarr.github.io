---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { slugify } from '../../utils';

const posts = await getCollection('posts');

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = new Set<string>();
  posts.forEach((p) => p.data.categories.forEach((c) => categories.add(slugify(c))));
  return [...categories].map((category) => ({ params: { category }, props: { category } }));
}

const { category } = Astro.props;
const tagged = posts
  .filter((p) => !p.data.draft && p.data.categories.some((c) => slugify(c) === category))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const display =
  tagged[0]?.data.categories.find((c) => slugify(c) === category) ?? category;
---

<BaseLayout title={`${display} — Debakar Roy`} description={`Posts in the ${display} category.`}>
  <div class="py-10">
    <a href="/tags" class="text-sm text-muted transition-colors hover:text-accent">← All topics</a>
    <h1 class="mb-2 mt-4 text-3xl font-bold tracking-tight">{display}</h1>
    <p class="mb-8 text-sm text-muted">{tagged.length} {tagged.length === 1 ? 'post' : 'posts'}</p>
    <PostList posts={tagged} />
  </div>
</BaseLayout>
