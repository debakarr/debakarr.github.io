---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import avatar from '../assets/avatar.png';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const roles = ['DevOps Engineer', 'Cloud Enthusiast', 'Automation Nerd', 'Occasional Blogger'];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="dot-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative flex flex-col items-center gap-5 pb-14 pt-16 text-center sm:pt-20">
      <Image
        src={avatar}
        alt="Debakar Roy"
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        class="h-24 w-24 rounded-full ring-2 ring-line transition hover:ring-accent"
      />
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Debakar Roy</h1>
      <p class="font-mono text-sm text-muted">
        <span class="sr-only">{roles.join(', ')}</span>
        <span aria-hidden="true"><span id="typewriter"></span><span class="type-cursor"></span></span>
      </p>
      <p class="max-w-md text-balance text-muted">
        Welcome to my blog — notes on DevOps, AWS, automation and everything in between.
      </p>
      <SocialLinks />
    </div>
  </section>

  <section class="pb-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="text-lg font-semibold tracking-tight">Latest writing</h2>
      <a href="/posts" class="text-sm text-muted transition-colors hover:text-accent">View all →</a>
    </div>
    <PostList posts={posts} descriptions />
  </section>

  <script define:vars={{ roles }}>
    // Inline scripts re-execute after view-transition swaps into this page:
    // cancel any previous loop so timers don't stack up.
    (() => {
      clearTimeout(window.__typeTimer);
      const el = document.getElementById('typewriter');
      if (!el) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = roles[0];
        return;
      }
      let roleIndex = 0;
      let charIndex = 0;
      let deleting = false;

      function tick() {
        const role = roles[roleIndex];
        charIndex += deleting ? -1 : 1;
        el.textContent = role.slice(0, charIndex);
        let delay = deleting ? 40 : 75;
        if (!deleting && charIndex === role.length) {
          delay = 1800;
          deleting = true;
        } else if (deleting && charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
          delay = 400;
        }
        window.__typeTimer = setTimeout(tick, delay);
      }
      tick();
    })();
  </script>
</BaseLayout>
