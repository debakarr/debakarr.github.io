{
  "name": "debakarr-github-io",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "extract": "node scripts/extract-posts.mjs",
    "resume": "docker run --rm -v \"$PWD/resume\":/work -w /work texlive/texlive:latest latexmk -xelatex -interaction=nonstopmode -halt-on-error resume.tex && cp resume/resume.pdf public/resume/debakar_roy_resume.pdf"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.7",
    "cheerio": "^1.0.0",
    "pagefind": "^1.3.0",
    "simple-icons": "^16.28.0",
    "tailwindcss": "^4.0.7",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
